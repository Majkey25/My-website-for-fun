{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "init-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // The built site is served from the same Worker; only /api/* runs code.
  "assets": {
    "binding": "ASSETS",
    "directory": "../dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // Re-crawl the knowledge sources four times a day.
  "triggers": { "crons": ["17 */6 * * *"] },
  "ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "init" }],
  // Approximate, per Cloudflare location; these limits do not enforce an account spending cap.
  "ratelimits": [
    { "name": "RL_SESSION", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "4102", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "4103", "simple": { "limit": 12, "period": 60 } },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://init-chat.majkeylab.workers.dev",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    // Existing complimentary quota/credits only; never buy credits or enable automatic recharge.
    // Data sharing: gpt-6-luna is eligible for 250k/1M daily tokens in enrolled projects.
    // gpt-5.6-luna and gpt-5.6-terra use the separate 2.5M/10M pool, depending on account tier.
    // Full list from the owner's eligibility notice, supplied 2026-11-01 (Build daily pools):
    //   250,000 shared tokens: gpt-5.4, gpt-5.2, gpt-5.1, gpt-5, gpt-4.1, gpt-4o, o1, o3.
    //   2,500,000 shared tokens: gpt-5.4-mini, gpt-5.4-nano, gpt-5-mini, gpt-5-nano,
    //     gpt-4.1-mini, gpt-4.1-nano, gpt-4o-mini, o3-mini, o4-mini.
    // Future candidate when Luna's daily pool is spent: gpt-5.4-mini with low reasoning,
    // for the larger pool; evaluate gpt-5.4 with low reasoning when answer quality takes priority.
    // Recheck access, supported images/tools, current eligibility and RAG quality before switching;
    // the notice is not an availability guarantee, and some older models have been retired.
    // This comment does not implement automatic fallback or change the selected model below.
    // IMPORTANT: even complimentary tokens require a POSITIVE account balance. A model switch
    // cannot restore free use at zero credits. Pools reset at 00:00 UTC; they are not per model.
    // A request crossing a pool limit is billed in full; web-search tools are charged separately.
    // Keep automatic recharge disabled. These settings do not enforce an account spending cap.
    // https://help.openai.com/en/articles/10306912
    // https://developers.openai.com/api/docs/models/gpt-5.4-mini
    // https://developers.openai.com/api/docs/models/gpt-5.4
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_REASONING": "low",
  },
  // Secrets, set with `wrangler secret put <NAME>` and never committed:
  // OPENAI_API_KEY, SESSION_SECRET, TURNSTILE_SECRET
}
