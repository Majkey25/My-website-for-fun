{
  "name": "init",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of Matěj Teplý, AI/ML engineer and backend developer.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
