    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "@lhci/cli@0.15.1": {
      "chrome-launcher@0.13.4": "0.15.2",
      "lighthouse": "13.5.0",
      "proxy-agent": "8.0.2",
      "puppeteer-core": "25.15.0",
