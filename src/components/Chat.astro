---
// The site assistant: a launcher and a dialog that streams answers with their sources.
// All model text is turned into DOM nodes (never innerHTML); links must be https.
// Render it only when the assistant is configured: a site without it then loads none of its
// markup or script (the global styles below are still inlined).
import { starters } from '../chat';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Arrow from './Arrow.astro';
import type { Lang } from '../i18n';
import { href, slug } from '../site';
import { projectMedia } from '../project-media';

interface Props {
  lang: Lang;
  api: string;
  siteKey: string;
}
const { lang, api, siteKey } = Astro.props;
const cs = lang === 'cs';
const media = await Promise.all(
  (await getCollection('projects')).flatMap(({ data }) => {
    const item = projectMedia[data.name];
    if (!item) return [];
    return [
      (async () => {
        const image = await getImage({ src: item.image, width: 640, format: 'webp' });
        return {
          name: data.name,
          alt: item.alt[lang],
          image: image.src,
          width: Number(image.attributes.width),
          height: Number(image.attributes.height),
          href: href(`work/${slug(data.name)}/`, lang),
          repo: new URL(item.source).pathname.split('/').slice(0, 3).join('/').toLowerCase(),
        };
      })(),
    ];
  }),
);
const text = cs
  ? {
      launch: 'Zeptejte se mého AI agenta',
      title: 'Zeptejte se na mou práci',
      sub: 'Odpovědi čerpají z mých projektů, profesního profilu a vybraných veřejných zdrojů.',
      label: 'Vaše otázka',
      placeholder: 'Projekty, služby, zkušenosti…',
      send: 'Odeslat',
      stop: 'Zastavit',
      close: 'Zavřít',
      reset: 'Nový chat',
      history: 'Historie chatů',
      back: 'Zpět',
      note: 'Otázky i obrázky zpracuje OpenAI přes Cloudflare. OpenAI může sdílený obsah použít k trénování modelů. Obrázky se neukládají do místní historie. Nesdílejte citlivé údaje.',
      attach: 'Přiložit obrázek',
      remove: 'Odebrat obrázek',
      remember: 'Uložit tento chat na zařízení na 7 dní',
      privacy: 'Soukromí',
    }
  : {
      launch: 'Ask my AI agent',
      title: 'Ask about my work',
      sub: 'Answers draw on my projects, professional profile and selected public sources.',
      label: 'Your question',
      placeholder: 'Projects, services, experience…',
      send: 'Send',
      stop: 'Stop',
      close: 'Close',
      reset: 'New chat',
      history: 'Chat history',
      back: 'Back',
      note: 'Questions and images go to OpenAI through Cloudflare. OpenAI may use shared content to train models. Images are not saved in local history. Do not share sensitive data.',
      attach: 'Attach an image',
      remove: 'Remove image',
      remember: 'Save this chat on this device for 7 days',
      privacy: 'Privacy',
    };
// Strings the script needs at runtime.
const runtime = cs
  ? {
      sources: 'Zdroje',
      searching: 'Hledám na webu…',
      verifying: 'Ověřuji prohlížeč. Pokud se zobrazí kontrola, potvrďte ji níže.',
      web: 'Prohledávám povolené veřejné zdroje…',
      writing: 'Píšu odpověď…',
      ready: 'Odpověď je hotová.',
      copy: 'Kopírovat',
      copied: 'Zkopírováno',
      retry: 'Zkusit znovu',
      busy: 'Příliš mnoho otázek najednou. Zkuste to za minutu.',
      quota: 'Asistent vyčerpal dostupný limit API. Napište mi prosím přes kontaktní formulář.',
      challenge: 'Kontrola prohlížeče neprošla. Obnovte stránku a zkuste to znovu.',
      unavailable: 'Odpověď nedorazila. Zkuste to znovu.',
      stopped: 'Zastaveno.',
      image: 'Přiložený obrázek',
      imageExpired: 'Obrázek se do historie neukládá. Pro další otázku ho přiložte znovu.',
      imageLoading: 'Připravuji obrázek…',
      imageInvalid: 'Vyberte JPG, PNG nebo WebP do 10 MB. Obrázek se nepodařilo připravit.',
      historyUnavailable: 'Prohlížeč nedovolil uložit historii. Chat zůstane jen na této stránce.',
      historyEmpty: 'Zatím nemáte žádné konverzace.',
      historyFull: 'Máte 10 uložených chatů. Pro nový chat nejprve jeden smažte.',
      saved: 'Uloženo na 7 dní',
      tabOnly: 'Pouze v této kartě',
      untitled: 'Konverzace s obrázkem',
      delete: 'Smazat chat',
      followups: 'Na co se zeptat dál',
    }
  : {
      sources: 'Sources',
      searching: 'Searching the site…',
      verifying: 'Checking your browser. Complete the check below if it appears.',
      web: 'Searching approved public sources…',
      writing: 'Writing…',
      ready: 'Answer ready.',
      copy: 'Copy',
      copied: 'Copied',
      retry: 'Try again',
      busy: 'Too many questions at once. Try again in a minute.',
      quota:
        'The assistant has reached its API allowance. Please write to me through the contact form.',
      challenge: 'The browser check did not pass. Reload the page and try again.',
      unavailable: 'The answer did not arrive. Try again.',
      stopped: 'Stopped.',
      image: 'Attached image',
      imageExpired: 'Images are not saved in history. Attach it again for another question.',
      imageLoading: 'Preparing image…',
      imageInvalid: 'Choose a JPG, PNG or WebP under 10 MB. The image could not be prepared.',
      historyUnavailable:
        'Your browser blocked history storage. This chat will last for this page only.',
      historyEmpty: 'No conversations yet.',
      historyFull: 'You have 10 saved chats. Delete one before starting another.',
      saved: 'Saved for 7 days',
      tabOnly: 'This tab only',
      untitled: 'Image conversation',
      delete: 'Delete chat',
      followups: 'Ask next',
    };
---

<site-chat
  class="no-print"
  data-api={api}
  data-site-key={siteKey}
  data-lang={lang}
  data-text={JSON.stringify(runtime)}
  data-media={JSON.stringify(media)}
>
  <button class="chat-launch" type="button" aria-haspopup="dialog" data-chat-open>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M12 3c.5 4.6 3.4 7.5 8 8-4.6.5-7.5 3.4-8 8-.5-4.6-3.4-7.5-8-8 4.6-.5 7.5-3.4 8-8Z" />
    </svg>
    <span>{text.launch}</span>
  </button>
  <dialog class="chat" aria-labelledby="chat-title">
    <div class="chat__head">
      <div>
        <h2 id="chat-title">{text.title}</h2>
        <p>{text.sub}</p>
      </div>
      <button class="chat__icon" type="button" data-chat-reset title={text.reset}>
        <span class="sr-only">{text.reset}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M12 4v16M4 12h16" />
        </svg>
      </button>
      <button
        class="chat__icon"
        type="button"
        data-chat-history
        title={text.history}
        aria-expanded="false"
        aria-controls="chat-history"
      >
        <span class="sr-only">{text.history}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M3 11a9 9 0 1 1 2.6 7.4M3 5v6h6M12 7v5l3 2" />
        </svg>
      </button>
      <button class="chat__icon" type="button" data-chat-close title={text.close}>
        <span class="sr-only">
          {text.back} / {text.close}
        </span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="m14 5-7 7 7 7M7 12h14" />
        </svg>
      </button>
    </div>
    <section class="chat__history" id="chat-history" aria-label={text.history} hidden>
      <h3>{text.history}</h3>
      <ul />
    </section>
    <div class="chat__log" role="log" aria-labelledby="chat-title" tabindex="0">
      <ul class="chat__starters">
        {starters[lang].map((question, i) => (
          <li style={`--i: ${i}`}>
            <button type="button" data-chat-ask={question}>
              {question}
            </button>
          </li>
        ))}
      </ul>
    </div>
    <p class="chat__status" role="status" />
    <div class="chat__check" />
    <div class="chat__attachment" hidden>
      <img alt={runtime.image} width="56" height="56" />
      <span>{runtime.image}</span>
      <button class="chat__icon" type="button" data-chat-remove title={text.remove}>
        <span class="sr-only">{text.remove}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <form class="chat__form">
      <input type="file" accept="image/jpeg,image/png,image/webp" data-chat-file hidden />
      <button class="chat__icon chat__attach" type="button" data-chat-attach title={text.attach}>
        <span class="sr-only">{text.attach}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m8 12 6-6a3 3 0 0 1 4 4l-8 8a5 5 0 0 1-7-7l9-9M7 15l9-9" />
        </svg>
      </button>
      <label class="sr-only" for="chat-input">
        {text.label}
      </label>
      <textarea
        id="chat-input"
        name="question"
        rows="1"
        maxlength="2000"
        enterkeyhint="send"
        placeholder={text.placeholder}
        autofocus
      />
      <button class="chat__send" type="submit">
        <span class="sr-only" data-send-label>
          {text.send}
        </span>
        <span class="sr-only" data-stop-label hidden>
          {text.stop}
        </span>
        <Arrow class="chat__send-icon" direction="up" />
        <svg class="chat__stop-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <rect x="5" y="5" width="14" height="14" rx="2" />
        </svg>
      </button>
    </form>
    <label class="chat__remember">
      <input type="checkbox" data-chat-remember />
      {text.remember}
    </label>
    <p class="chat__note">
      {text.note} <a href={href('privacy/', lang)}>{text.privacy}</a>
    </p>
  </dialog>
</site-chat>

<script>
  import {
    chatSources,
    chatFollowups,
    HISTORY_LIMIT,
    HISTORY_TTL_MS,
    THREAD_LIMIT,
    readThreads,
    writeThreads,
    type ChatThread,
    type ChatSource as Source,
    type ChatTurn as Stored,
  } from '../chat-history';
  type Session = { token: string; expires: number };
  type Runtime = Record<
    | 'sources'
    | 'searching'
    | 'verifying'
    | 'web'
    | 'writing'
    | 'ready'
    | 'copy'
    | 'copied'
    | 'retry'
    | 'busy'
    | 'quota'
    | 'challenge'
    | 'unavailable'
    | 'stopped'
    | 'image'
    | 'imageExpired'
    | 'imageLoading'
    | 'imageInvalid'
    | 'historyUnavailable'
    | 'historyEmpty'
    | 'historyFull'
    | 'saved'
    | 'tabOnly'
    | 'untitled'
    | 'delete'
    | 'followups',
    string
  >;
  type Turnstile = {
    render: (box: HTMLElement, options: Record<string, unknown>) => string;
    remove: (id: string) => void;
  };
  type ProjectImage = {
    name: string;
    alt: string;
    image: string;
    width: number;
    height: number;
    href: string;
    repo: string;
  };

  const STORE = 'chat:v2';
  const SESSION = 'chat:session';
  const MAX_TURNS = 12; // the Worker accepts at most 12
  const MAX_ASSISTANT = 6000;
  const MAX_CHARS = 30_000;
  const MAX_BYTES = 5 * 1024 * 1024;

  class ChatError extends Error {}

  // ---------- Markdown subset into DOM nodes ----------

  const INLINE = /(\*\*[^*\n]+\*\*|`[^`\n]+`|\[S\d{1,2}\]|\[[^\]\n]+\]\(https:\/\/[^)\s]+\))/g;

  function inline(text: string, sources: Source[]): Node[] {
    return text.split(INLINE).flatMap((part, i): Node[] => {
      if (!part) return [];
      if (i % 2 === 0) return [document.createTextNode(part)];
      if (part.startsWith('**')) {
        const strong = document.createElement('strong');
        strong.textContent = part.slice(2, -2);
        return [strong];
      }
      if (part.startsWith('`')) {
        const code = document.createElement('code');
        code.textContent = part.slice(1, -1);
        return [code];
      }
      const cite = /^\[S(\d{1,2})\]$/.exec(part);
      if (cite) {
        const source = sources.find((s) => s.id === `S${cite[1]}`);
        if (!source) return [];
        if (source.url === null) {
          const label = document.createElement('span');
          label.className = 'chat__cite';
          label.textContent = cite[1] ?? '';
          label.title = source.title;
          return [label];
        }
        const link = document.createElement('a');
        link.className = 'chat__cite';
        link.href = source.url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = cite[1] ?? '';
        link.title = source.title;
        return [link];
      }
      const [, label = '', url = ''] = /^\[([^\]]+)\]\((.+)\)$/.exec(part) ?? [];
      if (!sources.some((source) => source.url === url)) return [document.createTextNode(label)];
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = label;
      return [link];
    });
  }

  function markdown(text: string, sources: Source[]): Node[] {
    const blocks: Node[] = [];
    // Widened on purpose: the loop reassigns both, which narrowing from `null` does not see.
    let list = null as HTMLElement | null;
    let code = null as HTMLElement | null;
    let paragraph: string[] = [];
    const flush = () => {
      if (!paragraph.length) return;
      const p = document.createElement('p');
      p.append(...inline(paragraph.join(' '), sources));
      blocks.push(p);
      paragraph = [];
    };
    for (const line of text.split('\n')) {
      if (line.trimStart().startsWith('```')) {
        flush();
        list = null;
        if (code) code = null;
        else {
          const pre = document.createElement('pre');
          code = document.createElement('code');
          pre.append(code);
          blocks.push(pre);
        }
        continue;
      }
      if (code) {
        code.append(`${code.childNodes.length ? '\n' : ''}${line}`);
        continue;
      }
      const item = /^\s*(?:[-*]|(\d+)\.)\s+(.*)$/.exec(line);
      if (item) {
        flush();
        const tag = item[1] ? 'OL' : 'UL';
        if (list?.tagName !== tag) {
          list = document.createElement(tag);
          blocks.push(list);
        }
        const li = document.createElement('li');
        li.append(...inline(item[2] ?? '', sources));
        list.append(li);
        continue;
      }
      list = null;
      if (line.trim()) paragraph.push(line.trim());
      else flush();
    }
    flush();
    return blocks;
  }

  // ---------- The element ----------

  class SiteChat extends HTMLElement {
    #api = this.dataset.api ?? '';
    #lang = this.dataset.lang === 'cs' ? 'cs' : 'en';
    #text = JSON.parse(this.dataset.text ?? '{}') as Runtime;
    #media = JSON.parse(this.dataset.media ?? '[]') as ProjectImage[];
    #dialog = this.querySelector('dialog')!;
    #log = this.querySelector<HTMLElement>('.chat__log')!;
    #starters = this.querySelector<HTMLElement>('.chat__starters')!;
    #status = this.querySelector<HTMLElement>('.chat__status')!;
    #form = this.querySelector('form')!;
    #send = this.querySelector<HTMLButtonElement>('.chat__send')!;
    #input = this.querySelector('textarea')!;
    #check = this.querySelector<HTMLElement>('.chat__check')!;
    #remember = this.querySelector<HTMLInputElement>('[data-chat-remember]')!;
    #history = this.querySelector<HTMLElement>('.chat__history')!;
    #historyButton = this.querySelector<HTMLButtonElement>('[data-chat-history]')!;
    #file = this.querySelector<HTMLInputElement>('[data-chat-file]')!;
    #attach = this.querySelector<HTMLButtonElement>('[data-chat-attach]')!;
    #preview = this.querySelector<HTMLElement>('.chat__attachment')!;
    #image: string | null = null;
    #imageVersion = 0;
    #preparing = false;
    #turns: Stored[] = [];
    #threads: ChatThread[] = [];
    #activeId = '';
    #busy: AbortController | null = null;
    #turnstile: Promise<Turnstile> | null = null;
    #current: Session | null = null;
    #minting: Promise<string> | null = null;

    connectedCallback() {
      let local = null;
      let session = null;
      try {
        local = localStorage.getItem(STORE);
      } catch {}
      try {
        session = sessionStorage.getItem(STORE);
      } catch {}
      const history = readThreads(session, local);
      this.#threads = history.threads;
      if (history.activeId) this.#selectThread(history.activeId);
      else this.#newThread();

      this.querySelector('[data-chat-open]')?.addEventListener('click', () => this.open());
      this.querySelector('[data-chat-close]')?.addEventListener('click', () => {
        if (!this.#history.hidden) this.#showHistory(false);
        else this.#dialog.close();
      });
      this.querySelector('[data-chat-reset]')?.addEventListener('click', () => this.#newThread());
      this.#historyButton.addEventListener('click', () =>
        this.#showHistory(!!this.#history.hidden),
      );
      this.#remember.addEventListener('change', () => this.#save(false));
      this.#send.addEventListener('click', (event) => {
        if (!this.#busy) return;
        // Aborting can restore type=submit before the click's default action runs.
        event.preventDefault();
        this.#busy.abort();
      });
      this.#attach.addEventListener('click', () => this.#file.click());
      this.querySelector('[data-chat-remove]')?.addEventListener('click', () => this.#clearImage());
      this.#file.addEventListener('change', () => void this.#prepareImage());
      // A click on the backdrop closes the panel. The dialog element is also the target of clicks
      // in its own padding and of a text selection dragged out of it, so both the press and the
      // release must land outside its box.
      const outside = (e: MouseEvent) => {
        const box = this.#dialog.getBoundingClientRect();
        return (
          e.target === this.#dialog &&
          (e.clientX < box.left ||
            e.clientX > box.right ||
            e.clientY < box.top ||
            e.clientY > box.bottom)
        );
      };
      let pressedOutside = false;
      this.#dialog.addEventListener('pointerdown', (e) => (pressedOutside = outside(e)));
      this.#dialog.addEventListener('click', (e) => {
        if (pressedOutside && outside(e)) this.#dialog.close();
      });
      this.#dialog.addEventListener('close', () =>
        document.documentElement.classList.remove('chat-open'),
      );
      this.addEventListener('click', (e) => {
        const ask = (e.target as HTMLElement).closest<HTMLElement>('[data-chat-ask]');
        if (ask?.dataset.chatAsk) {
          if (this.#busy) this.#input.value = ask.dataset.chatAsk;
          else this.ask(ask.dataset.chatAsk);
        }
      });
      this.#form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (this.#busy) return;
        this.ask(this.#input.value);
      });
      this.#input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          this.#form.requestSubmit();
        }
      });
      document.addEventListener('chat:ask', (e) => {
        const question = (e as CustomEvent<string>).detail;
        this.open();
        // While an answer streams, keep the question in the composer instead of dropping it.
        if (question && this.#busy) this.#input.value = question;
        else if (question) this.ask(question);
      });
      // Someone started typing elsewhere on the page: pass the browser check now.
      document.addEventListener('chat:warm', () =>
        this.#session(new AbortController().signal).catch(() => undefined),
      );
    }

    open() {
      this.#expireThreads();
      if (this.#dialog.open) return;
      document.documentElement.classList.add('chat-open');
      this.#dialog.showModal();
      this.#log.scrollTop = this.#log.scrollHeight;
      // Pass the browser check while the visitor types; the first question then needs no wait.
      this.#session(new AbortController().signal).catch(() => undefined);
    }

    ask(raw: string) {
      this.#expireThreads();
      const question = raw.trim().slice(0, 2000);
      if ((!question && !this.#image) || this.#busy || this.#preparing) return;
      this.#showHistory(false);
      this.#input.value = '';
      this.#log.querySelectorAll('.msg--error').forEach((note) => note.remove());
      const turn: Stored = {
        role: 'user',
        content: question,
        ...(this.#image ? { images: [this.#image] } : {}),
      };
      this.#clearImage();
      this.#turns.push(turn);
      let images = 0;
      for (const previous of [...this.#turns].reverse()) {
        if (previous.images?.length && ++images > 3) {
          delete previous.images;
          previous.imageExpired = true;
        }
      }
      this.#bubble(turn);
      this.#save();
      void this.#answer();
    }

    #sync() {
      this.#starters.hidden = this.#turns.length > 0;
      this.#dialog.classList.toggle('has-messages', this.#turns.length > 0);
    }

    #save(touched = true) {
      this.#turns = this.#turns.slice(-HISTORY_LIMIT);
      const active = this.#threads.find((thread) => thread.id === this.#activeId);
      if (active) {
        active.turns = this.#turns;
        active.saved = this.#remember.checked;
        active.title =
          this.#turns.find((turn) => turn.role === 'user')?.content.slice(0, 120) ?? '';
        if (touched) active.updatedAt = Date.now();
      }
      let saved = this.#threads.filter((thread) => thread.saved);
      try {
        saved = readThreads(null, localStorage.getItem(STORE)).threads.filter(
          (thread) => thread.id !== this.#activeId,
        );
        if (active?.saved) {
          if (saved.length >= THREAD_LIMIT) {
            active.saved = false;
            this.#remember.checked = false;
            this.#status.textContent = this.#text.historyFull;
          } else saved.push(active);
        }
        const merged = new Map(saved.map((thread) => [thread.id, thread]));
        // The active conversation belongs to this tab; inactive saved chats come from shared storage.
        for (const thread of this.#threads)
          if (!thread.saved || thread.id === this.#activeId) merged.set(thread.id, thread);
        this.#threads = [...merged.values()]
          .sort(
            (a, b) =>
              Number(b.id === this.#activeId) - Number(a.id === this.#activeId) ||
              b.updatedAt - a.updatedAt,
          )
          .slice(0, THREAD_LIMIT);
      } catch {
        // A storage read failure must not discard chats already held in memory.
      }
      const messages = this.#log.querySelectorAll('.msg');
      for (let i = 0; i < messages.length - HISTORY_LIMIT; i++) messages[i]?.remove();
      this.#sync();
      try {
        sessionStorage.setItem(STORE, writeThreads(this.#threads, this.#activeId));
      } catch {
        // Storage blocked: the conversation lasts for this page only.
      }
      try {
        if (saved.length) localStorage.setItem(STORE, writeThreads(saved, this.#activeId, true));
        else localStorage.removeItem(STORE);
      } catch {
        if (this.#remember.checked) this.#status.textContent = this.#text.historyUnavailable;
      }
    }

    #clearImage() {
      this.#imageVersion++;
      this.#image = null;
      this.#file.value = '';
      this.#preview.hidden = true;
      this.#preview.querySelector('img')!.removeAttribute('src');
    }

    async #prepareImage() {
      const file = this.#file.files?.[0];
      if (!file || this.#busy) return;
      this.#clearImage();
      const version = this.#imageVersion;
      this.#preparing = true;
      this.#attach.disabled = true;
      this.#status.textContent = this.#text.imageLoading;
      try {
        if (
          !['image/jpeg', 'image/png', 'image/webp'].includes(file.type) ||
          file.size > 10 * 1024 * 1024
        )
          throw new Error('Invalid image');
        const bitmap = await createImageBitmap(file);
        let blob: Blob | null;
        try {
          if (bitmap.width * bitmap.height > 16_000_000)
            throw new Error('Image dimensions too large');
          const scale = Math.min(1, 1280 / Math.max(bitmap.width, bitmap.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(bitmap.width * scale));
          canvas.height = Math.max(1, Math.round(bitmap.height * scale));
          const context = canvas.getContext('2d');
          if (!context) throw new Error('Image conversion unavailable');
          context.fillStyle = '#fff';
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          // Re-encoding strips image metadata before anything leaves the device.
          blob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(resolve, 'image/jpeg', 0.82),
          );
        } finally {
          bitmap.close();
        }
        if (!blob || blob.size > 1024 * 1024) throw new Error('Image too large');
        const data = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () =>
            typeof reader.result === 'string'
              ? resolve(reader.result)
              : reject(new Error('Invalid image'));
          reader.onerror = () => reject(new Error('Image read failed'));
          reader.readAsDataURL(blob);
        });
        if (version !== this.#imageVersion) return;
        this.#image = data;
        this.#preview.querySelector('img')!.src = data;
        this.#preview.hidden = false;
        this.#status.textContent = '';
      } catch {
        if (version === this.#imageVersion) this.#status.textContent = this.#text.imageInvalid;
      } finally {
        this.#preparing = false;
        this.#attach.disabled = !!this.#busy;
      }
    }

    #selectThread(id: string) {
      this.#expireThreads();
      const thread = this.#threads.find((entry) => entry.id === id);
      if (!thread) return;
      if (this.#activeId) this.#save(false);
      // Detach the old stream before changing its conversation.
      const running = this.#busy;
      this.#setBusy(null);
      running?.abort();
      this.#activeId = id;
      this.#turns = thread.turns;
      this.#remember.checked = thread.saved;
      this.#clearImage();
      this.#input.value = '';
      this.#log.querySelectorAll('.msg').forEach((m) => m.remove());
      for (const turn of this.#turns) this.#bubble(turn);
      this.#status.textContent = '';
      this.#showHistory(false);
      this.#save(false);
      if (this.#dialog.open) this.#input.focus();
    }

    #expireThreads() {
      const now = Date.now();
      this.#threads = this.#threads.filter((thread) => now - thread.updatedAt < HISTORY_TTL_MS);
      if (this.#activeId && !this.#threads.some((thread) => thread.id === this.#activeId)) {
        const running = this.#busy;
        this.#setBusy(null);
        running?.abort();
        this.#activeId = '';
        this.#turns = [];
        this.#newThread();
      }
    }

    #newThread() {
      this.#expireThreads();
      const empty = this.#threads.find((thread) => !thread.turns.length);
      if (empty) return this.#selectThread(empty.id);
      if (this.#threads.length >= THREAD_LIMIT) {
        const oldest = this.#threads
          .filter((thread) => !thread.saved)
          .sort((a, b) => a.updatedAt - b.updatedAt)[0];
        if (!oldest) {
          this.#showHistory(true);
          this.#status.textContent = this.#text.historyFull;
          return;
        }
        this.#threads = this.#threads.filter((thread) => thread.id !== oldest.id);
      }
      const id = crypto.randomUUID();
      this.#threads.push({ id, title: '', updatedAt: Date.now(), saved: false, turns: [] });
      this.#selectThread(id);
      if (this.#dialog.open) this.#input.focus();
    }

    #showHistory(show: boolean) {
      this.#expireThreads();
      if (show) this.#save(false);
      this.#history.hidden = !show;
      this.#log.hidden = show;
      this.#dialog.classList.toggle('show-history', show);
      this.#historyButton.setAttribute('aria-expanded', String(show));
      if (!show) return;
      const list = this.#history.querySelector('ul')!;
      list.replaceChildren();
      for (const thread of [...this.#threads].sort((a, b) => b.updatedAt - a.updatedAt)) {
        if (!thread.turns.length) continue;
        const row = document.createElement('li');
        const open = document.createElement('button');
        open.type = 'button';
        open.className = 'chat__thread';
        open.setAttribute('aria-current', String(thread.id === this.#activeId));
        const title = document.createElement('strong');
        title.textContent = thread.title || this.#text.untitled;
        const detail = document.createElement('span');
        detail.textContent = `${new Intl.DateTimeFormat(this.#lang, { dateStyle: 'short', timeStyle: 'short' }).format(thread.updatedAt)} · ${thread.saved ? this.#text.saved : this.#text.tabOnly}`;
        open.append(title, detail);
        open.addEventListener('click', () => this.#selectThread(thread.id));
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'chat__icon';
        remove.textContent = '×';
        remove.setAttribute(
          'aria-label',
          `${this.#text.delete}: ${thread.title || this.#text.untitled}`,
        );
        remove.addEventListener('click', () => {
          if (thread.id === this.#activeId) {
            const running = this.#busy;
            this.#setBusy(null);
            running?.abort();
            this.#activeId = '';
            this.#turns = [];
          }
          this.#threads = this.#threads.filter((entry) => entry.id !== thread.id);
          try {
            const saved = readThreads(null, localStorage.getItem(STORE));
            localStorage.setItem(
              STORE,
              writeThreads(
                saved.threads.filter((entry) => entry.id !== thread.id),
                null,
                true,
              ),
            );
          } catch {
            this.#status.textContent = this.#text.historyUnavailable;
          }
          if (!this.#activeId) {
            if (this.#threads[0]) this.#selectThread(this.#threads[0].id);
            else this.#newThread();
          }
          this.#save(false);
          this.#showHistory(true);
          this.#historyButton.focus();
        });
        row.append(open, remove);
        list.append(row);
      }
      if (!list.children.length) {
        const empty = document.createElement('li');
        empty.textContent = this.#text.historyEmpty;
        list.append(empty);
      }
    }

    #bubble(turn: Stored) {
      const item = document.createElement('div');
      item.className = `msg msg--${turn.role}`;
      const body = document.createElement('div');
      body.className = 'msg__body';
      item.append(body);
      if (turn.role === 'user') {
        body.textContent = turn.content;
        for (const data of turn.images ?? []) {
          const image = document.createElement('img');
          image.src = data;
          image.alt = this.#text.image;
          image.className = 'msg__image';
          body.append(image);
        }
        if (turn.imageExpired) {
          const note = document.createElement('p');
          note.className = 'meta';
          note.textContent = this.#text.imageExpired;
          body.append(note);
        }
      } else this.#fill(item, turn);
      this.#log.append(item);
      this.#log.scrollTop = this.#log.scrollHeight;
      return item;
    }

    /** Renders an assistant answer, its cited sources and the copy action. */
    #fill(item: HTMLElement, turn: Stored, streaming = false) {
      const following = this.#log.scrollHeight - this.#log.scrollTop - this.#log.clientHeight < 120;
      const sources = turn.sources ?? [];
      item.querySelector('.msg__body')!.replaceChildren(...markdown(turn.content, sources));
      item.classList.toggle('is-streaming', streaming);
      if (streaming) {
        if (following) this.#log.scrollTop = this.#log.scrollHeight;
        return;
      }
      const cited = sources.filter((s) => turn.content.includes(`[${s.id}]`));
      if (cited.length && !item.querySelector('.msg__media')) {
        const projects = this.#media
          .filter((project) =>
            cited.some((source) => {
              if (!source.url) return false;
              const url = new URL(source.url);
              const path = url.pathname.toLowerCase();
              if (url.hostname === 'github.com' || url.hostname === 'raw.githubusercontent.com')
                return path.split('/').slice(0, 3).join('/') === project.repo;
              return (
                url.origin === location.origin &&
                path.replace('/cs/', '/') === project.href.replace('/cs/', '/')
              );
            }),
          )
          .slice(0, 2);
        if (projects.length) {
          const previews = document.createElement('div');
          previews.className = 'msg__media';
          for (const project of projects) {
            const link = document.createElement('a');
            link.href = project.href;
            const image = document.createElement('img');
            image.src = project.image;
            image.alt = project.alt;
            image.width = project.width;
            image.height = project.height;
            image.loading = 'lazy';
            const caption = document.createElement('span');
            caption.textContent = project.name;
            link.append(image, caption);
            previews.append(link);
          }
          item.append(previews);
        }
      }
      if (cited.length && !item.querySelector('.msg__sources')) {
        const list = document.createElement('ol');
        list.className = 'msg__sources';
        list.setAttribute('aria-label', this.#text.sources);
        cited.forEach((s, i) => {
          const li = document.createElement('li');
          li.style.setProperty('--i', String(i));
          const link = document.createElement(s.url ? 'a' : 'details');
          const label = s.url ? link : document.createElement('summary');
          if (link instanceof HTMLAnchorElement && s.url) {
            link.href = s.url;
            link.target = '_blank';
            link.rel = 'noopener';
          }
          const num = document.createElement('span');
          num.textContent = s.id.slice(1);
          const title = document.createElement('span');
          title.textContent = s.title;
          label.append(num, title);
          if (!s.url) {
            const excerpt = document.createElement('p');
            excerpt.textContent = s.excerpt ?? s.title;
            link.append(label, excerpt);
          }
          li.append(link);
          list.append(li);
        });
        item.append(list);
      }
      if (turn.content && !item.querySelector('.msg__copy')) {
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'msg__copy';
        copy.textContent = this.#text.copy;
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(turn.content.replace(/\s?\[S\d{1,2}\]/g, ''));
            copy.textContent = this.#text.copied;
            setTimeout(() => (copy.textContent = this.#text.copy), 1600);
          } catch {
            this.#status.textContent = this.#text.unavailable;
          }
        });
        item.append(copy);
      }
      if (turn.followups?.length && !item.querySelector('.msg__followups')) {
        const questions = document.createElement('ul');
        questions.className = 'msg__followups';
        questions.setAttribute('aria-label', this.#text.followups);
        for (const question of turn.followups) {
          const li = document.createElement('li');
          const ask = document.createElement('button');
          ask.type = 'button';
          ask.dataset.chatAsk = question;
          ask.textContent = question;
          li.append(ask);
          questions.append(li);
        }
        item.append(questions);
      }
      if (following) this.#log.scrollTop = this.#log.scrollHeight;
    }

    #setBusy(busy: AbortController | null) {
      this.#busy = busy;
      this.#form.classList.toggle('is-busy', !!busy);
      this.#send.type = busy ? 'button' : 'submit';
      this.#log.setAttribute('aria-busy', String(!!busy));
      this.#attach.disabled = !!busy || this.#preparing;
      this.querySelector<HTMLElement>('[data-send-label]')!.hidden = !!busy;
      this.querySelector<HTMLElement>('[data-stop-label]')!.hidden = !busy;
    }

    // ---------- Network ----------

    #widget(): Promise<Turnstile> {
      this.#turnstile ??= new Promise<Turnstile>((resolve, reject) => {
        const existing = (window as unknown as { turnstile?: Turnstile }).turnstile;
        if (existing) return resolve(existing);
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        const fail = () => {
          clearTimeout(timer);
          script.remove();
          this.#turnstile = null;
          reject(new ChatError('challenge'));
        };
        const timer = setTimeout(fail, 15_000);
        script.onload = () => {
          clearTimeout(timer);
          const api = (window as unknown as { turnstile?: Turnstile }).turnstile;
          if (api) resolve(api);
          else fail();
        };
        script.onerror = fail;
        document.head.append(script);
      });
      return this.#turnstile;
    }

    /** A valid session token. Callers waiting at the same time share one browser check. */
    #session(signal: AbortSignal, fresh = false): Promise<string> {
      if (!fresh) {
        try {
          this.#current ??= JSON.parse(sessionStorage.getItem(SESSION) ?? 'null') as Session;
        } catch {
          // Unreadable or blocked storage: the session lives in memory only.
        }
        if (this.#current && this.#current.expires - Date.now() > 60_000)
          return Promise.resolve(this.#current.token);
      }
      const pending = (this.#minting ??= this.#mint().finally(() => (this.#minting = null)));
      return new Promise<string>((resolve, reject) => {
        const abort = () => reject(new ChatError('stopped'));
        if (signal.aborted) return abort();
        signal.addEventListener('abort', abort, { once: true });
        pending.then(resolve, reject).finally(() => signal.removeEventListener('abort', abort));
      });
    }

    async #mint(): Promise<string> {
      const turnstile = await this.#widget();
      let id = '';
      let timer: ReturnType<typeof setTimeout>;
      const proof = await new Promise<string>((resolve, reject) => {
        timer = setTimeout(() => reject(new ChatError('challenge')), 120_000);
        id = turnstile.render(this.#check, {
          sitekey: this.dataset.siteKey,
          language: this.#lang,
          appearance: 'interaction-only',
          callback: resolve,
          'error-callback': () => reject(new ChatError('challenge')),
          'timeout-callback': () => reject(new ChatError('challenge')),
          'unsupported-callback': () => reject(new ChatError('challenge')),
        });
      }).finally(() => {
        clearTimeout(timer);
        setTimeout(() => turnstile.remove(id));
      });
      const res = await fetch(`${this.#api}/session`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ turnstile: proof }),
        signal: AbortSignal.timeout(10_000),
      });
      if (!res.ok) throw new ChatError(res.status === 429 ? 'busy' : 'challenge');
      const session = (await res.json()) as Session;
      this.#current = session;
      try {
        sessionStorage.setItem(SESSION, JSON.stringify(session));
      } catch {
        // Blocked storage: the session lives in memory only.
      }
      return session.token;
    }

    async #post(body: string, signal: AbortSignal): Promise<Response> {
      for (const fresh of [false, true]) {
        this.#status.textContent = this.#text.verifying;
        const token = await this.#session(signal, fresh);
        signal.throwIfAborted();
        this.#status.textContent = this.#text.searching;
        const res = await fetch(`${this.#api}/chat`, {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: `Bearer ${token}`,
          },
          body,
          signal,
        });
        if (res.status !== 401) return res;
      }
      throw new ChatError('challenge');
    }

    async #answer() {
      const controller = new AbortController();
      this.#setBusy(controller);
      const turn: Stored = { role: 'assistant', content: '', sources: [] };
      const item = this.#bubble(turn);
      // Three dots breathe in turn until the first word arrives.
      const dots = document.createElement('span');
      dots.className = 'msg__dots';
      dots.append(...Array.from({ length: 3 }, () => document.createElement('i')));
      item.querySelector('.msg__body')!.append(dots);
      this.#status.textContent = this.#text.verifying;
      let frame = 0;
      const paint = () => {
        frame = 0;
        if (this.#busy !== controller) return;
        this.#fill(item, turn, true);
      };
      // A reset or a newer answer replaced this one; it must not touch the conversation.
      const stale = () => this.#busy !== controller;
      let failed = false;
      try {
        const messages = this.#turns
          .filter((turn) => turn.content.trim() || turn.images?.length)
          .slice(-MAX_TURNS)
          .map(({ role, content, images }) => ({
            role,
            content: content.slice(0, MAX_ASSISTANT),
            ...(images?.length ? { images } : {}),
          }));
        // The Worker also caps characters and bytes (Czech letters take two); drop the oldest.
        const body = () => JSON.stringify({ lang: this.#lang, messages });
        const chars = () => messages.reduce((sum, m) => sum + m.content.length, 0);
        while (
          messages.length > 1 &&
          (chars() > MAX_CHARS || new TextEncoder().encode(body()).length > MAX_BYTES)
        )
          messages.shift();
        const res = await this.#post(body(), controller.signal);
        if (!res.ok || !res.body) throw new ChatError(res.status === 429 ? 'busy' : 'unavailable');
        let buffer = '';
        let done = false;
        for await (const chunk of res.body.pipeThrough(new TextDecoderStream())) {
          buffer += chunk;
          for (let end = buffer.indexOf('\n\n'); end !== -1; end = buffer.indexOf('\n\n')) {
            const block = buffer.slice(0, end);
            buffer = buffer.slice(end + 2);
            const event = /^event: (.+)$/m.exec(block)?.[1];
            const data = JSON.parse(/^data: (.*)$/m.exec(block)?.[1] ?? 'null') as unknown;
            if (event === 'sources') turn.sources = chatSources(data);
            else if (event === 'suggestions')
              turn.followups = chatFollowups((data as { questions?: unknown } | null)?.questions);
            else if (event === 'status' && (data as { stage?: string } | null)?.stage === 'web')
              this.#status.textContent = this.#text.web;
            else if (event === 'delta') {
              const delta = (data as { text?: unknown } | null)?.text;
              if (typeof delta !== 'string' || turn.content.length + delta.length > MAX_ASSISTANT)
                throw new ChatError('unavailable');
              if (!turn.content) this.#status.textContent = this.#text.writing;
              turn.content += delta;
              frame ||= requestAnimationFrame(paint);
            } else if (event === 'done') done = true;
            else if (event === 'error') throw new ChatError((data as { code: string }).code);
          }
        }
        // Without `done` the connection dropped mid-answer.
        if (!done || !turn.content.trim()) throw new ChatError('unavailable');
        this.#status.textContent = this.#text.ready;
      } catch (error) {
        if (stale()) return;
        failed = true;
        const code = error instanceof ChatError ? error.message : 'unavailable';
        const message = controller.signal.aborted
          ? this.#text.stopped
          : code === 'busy' || code === 'quota' || code === 'challenge'
            ? this.#text[code]
            : this.#text.unavailable;
        // A cut-off or stopped answer stays readable but never enters the conversation, so it is
        // neither restored as complete after a reload nor sent back as context.
        if (turn.content.trim()) {
          item.classList.remove('is-streaming');
          item.classList.add('msg--partial');
          item
            .querySelector('.msg__body')!
            .replaceChildren(...markdown(turn.content, turn.sources ?? []));
        } else item.remove();
        this.#failure(message, code !== 'quota', item);
      } finally {
        cancelAnimationFrame(frame);
        if (!stale()) {
          if (!failed) {
            this.#fill(item, turn);
            this.#turns.push(turn);
          }
          this.#save(!failed);
          this.#setBusy(null);
        }
      }
    }

    /** An inline error; the retry answers the question that is still last in the conversation. */
    #failure(message: string, retry: boolean, partial: HTMLElement) {
      this.#status.textContent = '';
      const note = document.createElement('div');
      note.className = 'msg msg--error';
      note.textContent = `${message} `;
      if (retry) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = this.#text.retry;
        button.addEventListener('click', () => {
          note.remove();
          partial.remove();
          if (!this.#busy && this.#turns.at(-1)?.role === 'user') void this.#answer();
        });
        note.append(button);
      }
      this.#log.append(note);
      this.#log.scrollTop = this.#log.scrollHeight;
    }
  }

  customElements.define('site-chat', SiteChat);
</script>

<!-- Global: the script creates message elements, which scoped styles would not reach. -->
<style is:global>
  site-chat {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
    display: contents;
  }

  /* ---------- Launcher ---------- */

  .chat-launch {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0 1.2rem 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-stretch: 108%;
    transition:
      transform 160ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }

  .chat-launch svg {
    fill: var(--accent);
    transition: transform 400ms var(--ease-out);
  }

  .chat-launch:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .chat-launch:hover svg {
      transform: rotate(90deg) scale(1.1);
    }
  }

  .chat-open .chat-launch {
    opacity: 0;
    transform: scale(0.92);
    pointer-events: none;
  }

  /* ---------- Panel ---------- */

  .chat {
    --gap: clamp(1rem, 3vw, 1.25rem);
    position: fixed;
    inset: 1rem 1rem 1rem auto;
    width: min(34rem, 100vw - 2rem);
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    background: var(--bg);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--rule),
      0 32px 80px -24px rgb(0 0 0 / 0.5);
    display: none;
    grid-template-rows: auto minmax(0, 1fr) auto auto auto auto auto auto;
    overflow: hidden;
    opacity: 0;
    transform: translateX(1.25rem) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 160ms ease-out,
      transform 160ms ease-out,
      display 160ms allow-discrete,
      overlay 160ms allow-discrete;
  }

  .chat[open] {
    display: grid;
    opacity: 1;
    transform: none;
    transition:
      opacity 240ms var(--ease-out),
      transform 320ms var(--ease-out),
      display 320ms allow-discrete,
      overlay 320ms allow-discrete;

    @starting-style {
      opacity: 0;
      transform: translateX(1.25rem) scale(0.98);
    }
  }

  .chat::backdrop {
    background: rgb(0 0 0 / 0);
    transition:
      background-color 200ms ease-out,
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }

  .chat[open]::backdrop {
    background: rgb(0 0 0 / 0.32);

    @starting-style {
      background: rgb(0 0 0 / 0);
    }
  }

  @media (width < 40rem) {
    .chat.has-messages .chat__head p {
      display: none;
