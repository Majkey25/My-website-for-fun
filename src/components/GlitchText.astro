---
interface Props {
  text: string;
  scramble?: boolean;
}

const { text, scramble = false } = Astro.props;
---

<span class="sr-only">{text}</span>
<span class="glitch-label" data-text={text} aria-hidden="true">
  <span data-glitch-text data-scramble={scramble || undefined}>
    {text}
  </span>
</span>
