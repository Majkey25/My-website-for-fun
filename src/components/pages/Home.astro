---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Arrow from '../Arrow.astro';
import GlitchText from '../GlitchText.astro';
import Workbench from '../Workbench.astro';
import Base from '../../layouts/Base.astro';
import { chat, starters } from '../../chat';
import { href as siteHref, slug } from '../../site';
import { projectText, ui, type Lang } from '../../i18n';
import { projectMedia } from '../../project-media';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cs = lang === 'cs';
const t = ui[lang];
const href = (path = '') => siteHref(path, lang);
const projects = (await getCollection('projects')).map((entry) => projectText(entry.data, lang));
const selected = projects
  .filter((project) => project.featured && projectMedia[project.name])
  .sort((a, b) => (a.featured?.order ?? 0) - (b.featured?.order ?? 0))
  .slice(0, 6);
const pages = [
  {
    path: 'services/',
    id: 'services',
    title: t.services,
    text: cs
      ? 'AI strategie, integrace, školení a vývoj.'
      : 'AI strategy, integration, training and development.',
  },
  {
    path: 'about/',
    id: 'about',
    title: t.about,
    text: cs
      ? 'Zkušenosti, vzdělání a přístup k práci.'
      : 'Experience, education and the way I work.',
  },
  {
    path: 'contact/',
    id: 'contact',
    title: t.contact,
    text: cs ? 'Napište mi o svém projektu nebo týmu.' : 'Tell me about your project or team.',
  },
];
---

<Base lang={lang} intro>
  <section class="hero frame" aria-labelledby="hero-title">
    <h1 id="hero-title" class="name" data-enter style="--i:0">
      <GlitchText text="Matěj Teplý" scramble />
    </h1>
    <div class="hero__copy" data-enter style="--i:1">
      <p class="statement">
        {cs
          ? 'Tvořím užitečný software a pomáhám týmům pracovat s AI.'
          : 'I build useful software and help teams work with AI.'}
      </p>
      <p class="muted">
        {cs
          ? 'AI/ML inženýr a technologický konzultant ze Zlína.'
          : 'Applied AI/ML engineer and technology consultant in Zlín.'}
      </p>
      <div class="hero__actions">
        <a class="action-link" href={href('work/')} data-glitch>
          <GlitchText text={cs ? 'Moje projekty' : 'View my work'} /> <Arrow />
        </a>
        <a class="action-link" href={href('contact/')} data-glitch>
          <GlitchText text={cs ? 'Pojďme se domluvit' : "Let's talk"} />{' '}
          <Arrow direction="up-right" />
        </a>
      </div>
    </div>
    {!chat && <Workbench />}
    {chat && (
      <form class="ask" data-ask data-enter style="--i:2">
        <label class="ask__title" for="ask-input">
          {cs ? 'Zeptejte se mého AI agenta' : 'Ask my AI agent'}
        </label>
        <p class="muted">
          {cs ? 'Projekty, zkušenosti nebo AI školení.' : 'Projects, experience or AI training.'}
        </p>
        <div class="ask__field">
          <input
            id="ask-input"
            name="q"
            maxlength="2000"
            autocomplete="off"
            enterkeyhint="send"
            placeholder={cs ? 'Vaše otázka' : 'Your question'}
            required
          />
          <button type="submit">
            <span class="sr-only">{cs ? 'Zeptat se' : 'Ask'}</span>
            <Arrow />
          </button>
        </div>
        <button class="ask__starter" type="button" data-ask-starter={starters[lang][0]}>
          {starters[lang][0]}
        </button>
      </form>
    )}
  </section>

  <section id="work" class="section frame work-showcase" aria-labelledby="work-title">
    <div class="work-stage">
      <div class="section-heading">
        <h2 id="work-title" class="label">
          {cs ? 'Vybrané projekty' : 'Selected work'}
        </h2>
        <div class="work-controls">
          <button
            class="work-step"
            type="button"
            data-work-step="-1"
            aria-controls="selected-work"
            aria-label={cs ? 'Předchozí projekt' : 'Previous project'}
            disabled
          >
            <Arrow direction="left" />
          </button>
          <button
            class="work-step"
            type="button"
            data-work-step="1"
            aria-controls="selected-work"
            aria-label={cs ? 'Další projekt' : 'Next project'}
          >
            <Arrow />
          </button>
        </div>
      </div>
      <div class="work-viewport">
        <ol
          class="work-reel"
          id="selected-work"
          tabindex="0"
          aria-label={cs ? 'Vybrané projekty' : 'Selected projects'}
        >
          {selected.map((project, index) => {
            const media = projectMedia[project.name]!;
            const ratio = media.image.width / media.image.height;
            const portrait = ratio < 1;
            return (
              <li
                class:list={{ 'work-card--portrait': portrait }}
                style={`--project-ratio:${ratio}`}
              >
                <a class="work-scene" href={href(`work/${slug(project.name)}/`)}>
                  <h3 class="work-scene__name">{project.name}</h3>
                  <Image
                    class="work-scene__image"
                    src={media.image}
                    alt={media.alt[lang]}
                    widths={portrait ? [160, 240, 320, 480] : [320, 480, 640, 960, 1200]}
                    sizes={`(max-width:40rem) min(64vw, ${24 * ratio}svh, max(${5 * ratio}rem, calc(${100 * ratio}svh - ${32 * ratio}rem)), ${14 * ratio}rem), min(70vw, ${34 * ratio}svh, max(${5 * ratio}rem, calc(${100 * ratio}svh - ${32 * ratio}rem)), ${24 * ratio}rem)`}
                    priority={index === 0}
                  />
                  <p class="muted">{project.kind}</p>
                  <span class="work-scene__open">
                    {t.caseStudy} <Arrow direction="up-right" />
                  </span>
                </a>
                <ul class="work-links" aria-label={`${project.name}: ${t.links}`}>
                  {project.links.map((link) => (
                    <li>
                      <a class="action-link ext" href={link.href} rel="noopener" target="_blank">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ol>
      </div>
      <a class="action-link more" href={href('work/')} data-glitch>
        <GlitchText
          text={cs ? `Všech ${projects.length} projektů` : `All ${projects.length} projects`}
        />{' '}
        <Arrow />
      </a>
    </div>
  </section>

  <nav class="section frame explore" aria-label={cs ? 'Další stránky' : 'Explore the site'}>
    {pages.map((page) => (
      <a id={page.id} class="explore__link" href={href(page.path)}>
        <h2>{page.title}</h2>
        <p class="muted">{page.text}</p>
        <Arrow direction="up-right" />
      </a>
    ))}
  </nav>
</Base>

<script>
  import { onPage } from '../../scripts/page';
  // Same-URL clicks retain the old coordinate; only traversal or initial load restores it.
  let traversed = true;
  document.addEventListener('astro:before-swap', (event) => {
    traversed = event.navigationType === 'traverse';
  });
  onPage((signal) => {
    const ask = document.querySelector<HTMLFormElement>('[data-ask]');
    const send = (question: string) =>
      document.dispatchEvent(new CustomEvent('chat:ask', { detail: question }));
    ask?.addEventListener('focusin', () => document.dispatchEvent(new Event('chat:warm')), {
      once: true,
    });
    ask?.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = ask.querySelector('input');
      if (input?.value.trim()) send(input.value);
      if (input) input.value = '';
    });
    ask
      ?.querySelector<HTMLButtonElement>('[data-ask-starter]')
      ?.addEventListener('click', (event) => {
        const question = (event.currentTarget as HTMLButtonElement).dataset.askStarter;
        if (question) send(question);
      });
    const reel = document.querySelector<HTMLElement>('.work-reel');
    if (!reel) return;
    // Warm the visible panel and its next neighbour before sideways scrolling reveals it.
    const panels = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const panel of [entry.target, entry.target.nextElementSibling]) {
            const image = panel?.querySelector('img');
            if (image) image.loading = 'eager';
          }
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '200px 0px' },
    );
    reel?.querySelectorAll('li').forEach((panel) => panels.observe(panel));
    const showcase = document.querySelector<HTMLElement>('.work-showcase');
    const stage = document.querySelector<HTMLElement>('.work-stage');
    const viewport = document.querySelector<HTMLElement>('.work-viewport');
    const header = document.querySelector<HTMLElement>('.header');
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-work-step]');
    const quiet = matchMedia('(prefers-reduced-motion: reduce)');
    let pinned = false;
    let start = 0;
    let travel = 0;
    let frame = 0;
    let position = 0;
    const syncControls = () => {
      if (!reel) return;
      const offset = pinned ? position : reel.scrollLeft;
      buttons.forEach((button) => {
        button.disabled = Number(button.dataset.workStep) < 0 ? offset <= 1 : offset >= travel - 1;
      });
    };
    reel?.addEventListener('scroll', syncControls, { passive: true });
    const update = () => {
      frame = 0;
      if (pinned && reel) {
        position = Math.max(0, Math.min(travel, scrollY - start));
        reel.style.transform = `translate3d(${-position}px, 0, 0)`;
      }
      syncControls();
    };
    const measure = () => {
      if (!reel || !showcase || !stage) return;
      const top = (header?.offsetHeight ?? 0) + 16;
      const height = stage.offsetHeight;
      const padding = parseFloat(getComputedStyle(showcase).paddingTop);
      const last = reel.lastElementChild as HTMLElement | null;
      // Include the end gutter in both native-overflow and transformed-track modes.
      travel = last
        ? Math.max(
            0,
            last.offsetLeft +
              last.offsetWidth +
              parseFloat(getComputedStyle(reel).paddingInlineEnd) -
              reel.clientWidth,
          )
        : 0;
      start = showcase.getBoundingClientRect().top + scrollY + padding - top;
      // Short viewports keep native horizontal scrolling so the full card stays reachable.
      const wasPinned = pinned;
      pinned = !quiet.matches && travel > 0 && height <= innerHeight - top - 16;
      showcase.style.setProperty('--work-top', `${top}px`);
      showcase.classList.toggle('is-pinned', pinned);
      showcase.style.height = pinned ? `${height + padding + travel}px` : '';
      if (pinned) reel.scrollLeft = 0;
      else {
        reel.style.removeProperty('transform');
        if (wasPinned) reel.scrollLeft = position;
      }
      update();
    };
    addEventListener(
      'scroll',
      () => {
        if (pinned && !frame) frame = requestAnimationFrame(update);
      },
      { passive: true, signal },
    );
    addEventListener('resize', measure, { signal });
    quiet.addEventListener('change', measure, { signal });
    const observer = new ResizeObserver(measure);
    if (stage && header) {
      observer.observe(stage);
      observer.observe(header);
    }
    const move = (direction: number, behavior: ScrollBehavior) => {
      if (!reel) return;
      const offset = pinned ? position : reel.scrollLeft;
      const inset = parseFloat(getComputedStyle(reel).paddingInlineStart);
      const stops = Array.from(reel.children, (card) =>
        Math.max(0, Math.min(travel, (card as HTMLElement).offsetLeft - inset)),
      );
      if (direction < 0) stops.reverse();
      const target =
        stops.find((stop) => (direction < 0 ? stop < offset - 1 : stop > offset + 1)) ??
        (direction < 0 ? 0 : travel);
      if (pinned)
        scrollTo({
          top: start + target,
          behavior,
        });
      else reel.scrollTo({ left: target, behavior });
    };
    buttons.forEach((button) => {
      button.addEventListener('click', (event) => {
        move(
          Number(button.dataset.workStep),
          quiet.matches || event.detail === 0 ? 'instant' : 'smooth',
        );
      });
    });
    reel?.addEventListener('keydown', (event) => {
      if (!pinned || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      move(event.key === 'ArrowRight' ? 1 : -1, 'instant');
    });
    reel?.addEventListener('focusin', (event) => {
      const card = (event.target as Element).closest<HTMLElement>('li');
      if (!pinned || !card || !viewport || !reel) return;
      const box = card.getBoundingClientRect();
      const bounds = viewport.getBoundingClientRect();
      const inset = parseFloat(getComputedStyle(reel).paddingInlineStart);
      if (box.left < bounds.left + inset || box.right > bounds.right - inset)
        scrollTo({ top: start + Math.min(travel, card.offsetLeft - inset), behavior: 'instant' });
    });
    const restoredY = traversed ? history.state?.scrollY : undefined;
    measure();
    // Astro restores before this track expands; retain its existing history coordinate.
    if (typeof restoredY === 'number' && restoredY > 0)
      scrollTo({ top: restoredY, behavior: 'instant' });
    return () => {
      panels.disconnect();
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem 4rem;
    padding-top: clamp(3rem, 9vw, 6.5rem);
  }
  .hero .name {
    grid-column: 1/-1;
    font-size: clamp(2.75rem, 0.8rem + 10.2vw, 9.75rem);
    letter-spacing: -0.045em;
    line-height: 0.9;
  }
  .hero__copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .hero .statement {
    max-width: 26ch;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.5rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero__actions a:first-child {
    background: var(--ink);
    color: var(--bg);
  }
  .hero__actions a:first-child:is(:hover, :focus-visible) {
    background: var(--accent);
    color: var(--on-accent);
  }
  .ask {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 1.5rem;
    background: var(--surface);
  }
  .ask__title {
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1.2;
  }
  .ask__field {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    border-radius: 999px;
    background: var(--bg);
  }
  .ask__field:focus-within {
    box-shadow: 0 0 0 2px var(--accent);
  }
  .ask__field input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .ask__field input:focus {
    outline: none;
  }
  .ask__field button {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
  }
  .ask__field button :global(svg) {
    transition: translate 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ask__field button:hover :global(svg) {
      translate: 3px 0;
    }
  }
  .ask__starter {
    padding: 0.4rem 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    text-align: left;
    font-size: 0.875rem;
  }
  .ask__starter:hover {
    color: var(--ink);
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }
  .section-heading .label {
    margin-bottom: 0;
  }
  .work-showcase.is-pinned .work-stage {
    position: sticky;
    top: var(--work-top);
  }
  .work-viewport {
    margin-inline: calc(-1 * var(--pad));
    mask-image: linear-gradient(
      to right,
      transparent,
      rgb(0 0 0 / 0.35) calc(var(--pad) * 0.2),
      rgb(0 0 0 / 0.85) calc(var(--pad) * 0.55),
      #000 var(--pad),
      #000 calc(100% - var(--pad)),
      rgb(0 0 0 / 0.85) calc(100% - var(--pad) * 0.55),
      rgb(0 0 0 / 0.35) calc(100% - var(--pad) * 0.2),
      transparent
    );
  }
  .work-showcase {
    overflow-anchor: none;
  }
  .work-showcase.is-pinned .work-viewport {
    overflow: clip;
    overflow-clip-margin: 5px;
  }
  .work-showcase.is-pinned .work-reel {
    /* Move one composited track instead of fighting native nested scrolling. */
    overflow: visible;
    scroll-snap-type: none;
    scrollbar-width: none;
    will-change: transform;
  }
  .work-reel {
    /* Keep room for headings and links so the pinned gallery fits the viewport. */
    --work-image-height: min(34svh, max(5rem, calc(100svh - 32rem)), 24rem);
    --card-padding: clamp(1rem, 1.5vw, 1.25rem);
    --card-min-width: 16.5rem;
    align-items: stretch;
    position: relative;
    padding-inline: calc(var(--pad) + 0.25rem);
    padding-bottom: 0.25rem;
    scroll-padding-inline: calc(var(--pad) + 0.25rem);
  }
  .work-controls {
    margin: 0;
  }
  .work-reel > li {
    flex-basis: clamp(
      var(--card-min-width),
      calc(var(--work-image-height) * var(--project-ratio) + 2 * var(--card-padding)),
      84%
    );
    flex-direction: column;
    border-radius: 1rem;
    background: var(--surface);
  }
  .work-scene {
    flex: 1;
    min-height: 0;
    padding: var(--card-padding);
    gap: 0.75rem;
  }
  .work-scene__name {
    font-size: clamp(1.6rem, 3.5vw, 3rem);
  }
  .work-card--portrait .work-scene__name {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
  }
  .work-scene .muted {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .work-scene__image {
    align-self: center;
    width: calc(var(--work-image-height) * var(--project-ratio));
    height: auto;
    max-height: var(--work-image-height);
    aspect-ratio: var(--project-ratio);
    object-fit: contain;
    border: 0;
    background: transparent;
  }
  .work-scene__open {
    margin-top: auto;
    padding-top: 0;
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    padding: 0 var(--card-padding) var(--card-padding);
    font-size: 0.8125rem;
  }
  .work-links .action-link {
    padding-inline: 0.25rem;
    font-size: inherit;
  }
  .more {
    margin-top: 0.75rem;
  }
  .explore {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .explore__link {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.5rem 2rem 1.5rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color 180ms var(--ease);
  }
  .explore__link h2 {
    font-size: 1.4rem;
    font-weight: 600;
  }
  .explore__link :global(svg) {
    position: absolute;
    right: 0;
    top: 1.75rem;
    transition: transform 180ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .explore__link:hover {
      border-color: var(--accent);
    }
    .explore__link:hover :global(svg) {
      transform: translate(2px, -2px);
    }
  }
  @media (width < 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .explore {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  @media (width < 40rem) {
    .work-reel {
      --work-image-height: min(24svh, max(5rem, calc(100svh - 32rem)), 14rem);
    }
  }
  @media (height < 50rem) {
    .work-scene__name {
      font-size: clamp(1.6rem, 2vw, 2rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .explore__link :global(svg) {
      transition: none;
      transform: none;
    }
  }
</style>
