---
import { getCollection } from 'astro:content';
import GlitchText from '../GlitchText.astro';
import Arrow from '../Arrow.astro';
import Base from '../../layouts/Base.astro';
import { href as siteHref, slug } from '../../site';
import { projectText, groupLabels, ui, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const cs = lang === 'cs';
const t = ui[lang];
const groups = groupLabels[lang];
const href = (path = '') => siteHref(path, lang);
const projects = (await getCollection('projects')).map((e) => projectText(e.data, lang));
const sections = (Object.keys(groups) as (keyof typeof groups)[])
  .map((key) => ({ key, title: groups[key], list: projects.filter((p) => p.group === key) }))
  .filter((s) => s.list.length > 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  lang={lang}
  title={t.allProjects}
  description={
    cs
      ? 'Veřejné projekty Matěje Teplého: AI a jazyk, vývojářské nástroje, web, Android a rozšíření prohlížeče.'
      : 'Public projects by Matěj Teplý, grouped: AI and language, developer tools, web, Android apps and browser extensions.'
  }
>
  <section class="head frame" aria-labelledby="work-title">
    <p class="meta" data-enter style="--i: 0">
      <a href={href()}>~</a> / {t.work.toLowerCase()}
    </p>
    <h1 id="work-title" class="title" data-enter style="--i: 1">
      <GlitchText text={t.allProjects} scramble /> <span class="muted">({projects.length})</span>
    </h1>
    <p class="lead" data-enter style="--i: 2">
      {cs
        ? 'AI systémy, Android aplikace, weby a nástroje pro vývojáře.'
        : 'AI systems, Android apps, web projects and developer tools.'}
    </p>
    <nav aria-label={t.groups} data-enter style="--i: 3">
      <ul class="inline-list">
        {sections.map((s) => (
          <li>
            <a class="action-link" href={`#${s.key}`} data-glitch>
              <GlitchText text={s.title} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {sections.map((s) => (
    <section id={s.key} class="section wrap" aria-labelledby={`${s.key}-title`}>
      <h2 id={`${s.key}-title`} class="label">
        {s.title} <span class="count">({pad(s.list.length)})</span>
      </h2>
      <ul class="rows" data-reveal>
        {s.list.map((p) => (
          <li class="project">
            <div class="row">
              <a
                class="project__summary"
                href={href(`work/${slug(p.name)}/`)}
                data-desc={p.problem}
              >
                <span class="row__num">
                  <Arrow direction="up-right" />
                </span>
                <span class="row__main">
                  <span class="row__name">
                    {p.name}
                    {p.formerly && (
                      <span class="meta">
                        {' '}
                        {t.formerly} {p.formerly}
                      </span>
                    )}
                  </span>
                  <span class="row__kind">{p.kind}</span>
                  <span class="meta">{p.stack.join(' · ')}</span>
                </span>
              </a>
              <span class="row__meta links">
                <a class="action-link" href={href(`work/${slug(p.name)}/`)} data-glitch>
                  <GlitchText text={t.caseStudy} />
                  <span class="sr-only"> · {p.name}</span>
                </a>
                {p.links.map((l) => (
                  <a
                    class="action-link ext"
                    href={l.href}
                    rel="noopener"
                    target="_blank"
                    data-glitch
                  >
                    <GlitchText text={l.label} />
                    <span class="sr-only"> · {p.name}</span>
                  </a>
                ))}
                {p.source === 'private' && <span>{t.privateSource}</span>}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .head {
    display: grid;
    gap: 1.1rem;
    padding-block: clamp(3rem, 9vw, 6.5rem) 0;
  }

  .head a {
    text-decoration: none;
  }

  .head .lead a {
    text-decoration: underline;
  }

  .links {
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }

  .project__summary {
    display: grid;
    grid-column: 1 / 3;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    text-decoration: none;
  }

  .row:has(a:hover),
  .row:focus-within {
    background: var(--surface);
  }

  @media (width < 34rem) {
    .project__summary {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
