---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import GlitchText from '../GlitchText.astro';
import Arrow from '../Arrow.astro';
import Base from '../../layouts/Base.astro';
import { href as siteHref, slug } from '../../site';
import { projectText, groupLabels, ui, type Lang } from '../../i18n';
import { projectMedia } from '../../project-media';

interface Props {
  lang: Lang;
  p: CollectionEntry<'projects'>['data'];
  i: number;
  next: CollectionEntry<'projects'>['data'];
}
const { i, lang } = Astro.props;
const p = projectText(Astro.props.p, lang);
const next = projectText(Astro.props.next, lang);
const t = ui[lang];
const media = projectMedia[p.name];
const href = (path = '') => siteHref(path, lang);
const area = (x: typeof p) =>
  (lang === 'en' ? x.featured?.area : undefined) ?? groupLabels[lang][x.group];
const pad = (n: number) => String(n).padStart(2, '0');
const story = [
  { label: t.story[0], text: p.problem },
  { label: t.story[1], text: p.approach },
  { label: t.story[2], text: p.result },
];
---

<Base
  lang={lang}
  title={p.name}
  description={`${p.name}: ${p.kind}. ${p.problem}`}
  image={media?.image}
  imageAlt={media?.alt[lang]}
>
  <article class="case wrap">
    <p class="meta" data-enter style="--i: 0">
      <a href={href()}>~</a> / <a href={href('work/')}>{t.work.toLowerCase()}</a> / {pad(i + 1)}
    </p>
    <h1 class="title" data-enter style="--i: 0">
      <GlitchText text={p.name} scramble />
    </h1>
    <p class="statement" data-enter style="--i: 1">
      {p.kind}
    </p>
    <dl class="facts meta" data-enter style="--i: 2">
      <div>
        <dt class="muted">{t.area}</dt>
        <dd>{area(p)}</dd>
      </div>
      <div>
        <dt class="muted">{t.stack}</dt>
        <dd>{p.stack.join(' · ')}</dd>
      </div>
      <div>
        <dt class="muted">{t.asOf}</dt>
        <dd>{p.as_of}</dd>
      </div>
      {p.formerly && (
        <div>
          <dt class="muted">{t.formerly}</dt>
          <dd>{p.formerly}</dd>
        </div>
      )}
    </dl>

    {media && (
      <figure class="case__media">
        <Image
          src={media.image}
          alt={media.alt[lang]}
          widths={[400, 800, 1200, 1800]}
          sizes="(max-width: 48rem) 90vw, 46rem"
          priority
        />
        <figcaption class="meta">
          <a href={media.source} rel="noopener" target="_blank">
            {lang === 'cs'
              ? 'Ukázka z veřejné stránky projektu'
              : 'From the public project showcase'}
          </a>
        </figcaption>
      </figure>
    )}

    {story.map((s, index) => (
      <section class="part" aria-labelledby={`story-${index}-title`} data-reveal>
        <h2 id={`story-${index}-title`} class="label">
          {s.label}
        </h2>
        <p>{s.text}</p>
        {index === 1 && p.specimen && (
          <figure class="specimen">
            <figcaption class="meta">{t.example}</figcaption>
            <p lang="cs">
              <del>{p.specimen.before}</del>
            </p>
            <p lang="cs">
              <ins>{p.specimen.after}</ins>
            </p>
          </figure>
        )}
      </section>
    ))}

    <section class="part" aria-labelledby="links-title" data-reveal>
      <h2 id="links-title" class="label">
        {t.links}
      </h2>
      <ul class="inline-list">
        {p.links.map((l) => (
          <li>
            <a class="action-link ext" href={l.href} rel="noopener" target="_blank" data-glitch>
              <GlitchText text={l.label} />
            </a>
          </li>
        ))}
        {p.source === 'private' && <li class="meta">{t.privateSource}</li>}
      </ul>
    </section>

    <nav class="next" aria-label={t.nextProject}>
      <a class="row" href={href(`work/${slug(next.name)}/`)}>
        <span class="row__num">
          <Arrow />
        </span>
        <span class="row__main">
          <span class="meta">{t.next}</span>
          <span class="row__name">{next.name}</span>
        </span>
        <span class="row__meta">{area(next)}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case__media {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .case__media img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
  }

  .case {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(3rem, 10vw, 6rem);
  }

  .case > .meta a {
    text-decoration: none;
  }

  .facts {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .facts div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .facts dd {
    color: var(--ink);
  }

  .part {
    padding-top: clamp(2rem, 6vw, 3rem);
  }

  .part > p {
    max-width: 62ch;
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  .specimen {
    display: grid;
    gap: 0.3rem;
    margin-top: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
  }

  .specimen del {
    color: var(--muted);
    text-decoration-color: var(--split-a);
  }

  .specimen ins {
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 0.25em;
  }

  .next {
    margin-top: clamp(2.5rem, 7vw, 4rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
</style>
