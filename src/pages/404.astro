---
import Base from '../layouts/Base.astro';
import GlitchText from '../components/GlitchText.astro';
import { href } from '../site';
---

<Base title="Not found" description="This page does not exist." noindex>
  <section class="lost wrap" aria-labelledby="lost-title">
    <p class="meta" data-enter style="--i: 0">
      error 404
    </p>
    <h1 id="lost-title" class="title" data-enter style="--i: 1">
      This string is <span class="muted">out of tune.</span>
    </h1>
    <p class="lead" data-enter style="--i: 2">
      The page you are looking for does not exist or has moved.
    </p>
    <ul class="inline-list" data-enter style="--i: 3">
      <li>
        <a class="action-link" href={href()} data-glitch>
          <GlitchText text="Home" />
        </a>
      </li>
      <li>
        <a class="action-link" href={href('work/')} data-glitch>
          <GlitchText text="All projects" />
        </a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 14vw, 9rem) 0;
  }
</style>
