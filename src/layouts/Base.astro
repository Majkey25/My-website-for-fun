---
import { Font } from 'astro:assets';
import Chat from '../components/Chat.astro';
import Intro from '../components/Intro.astro';
import { chat } from '../chat';
import GlitchText from '../components/GlitchText.astro';
import SocialIcon from '../components/SocialIcon.astro';
import '../styles/global.css';
import { href, profile } from '../site';
import { languages, ui, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  intro?: boolean;
  lang?: Lang;
}

const { title, description, noindex = false, intro = !noindex, lang = 'en' } = Astro.props;
const t = ui[lang];
const path = noindex ? '' : Astro.url.pathname.slice(href().length).replace(/^cs\//, '');
const site = Astro.site ?? new URL('https://majkey25.github.io');
const url = (path: string) => new URL(path, site).href;
const pageTitle = title ? `${title} · Matěj Teplý` : t.title;
const pageDescription = description ?? t.description;
const nav = [
  { path: 'work', label: t.work },
  { path: 'services', label: t.services },
  { path: 'about', label: t.about },
  { path: 'contact', label: t.contact },
];
// Prefetch internal pages on hover; their scripts start only when the visitor navigates.
const speculation = {
  prefetch: [{ where: { href_matches: href('*') }, eagerness: 'moderate' }],
};
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matěj Teplý',
  alternateName: 'Majkey',
  url: url(href()),
  jobTitle: 'Technical Innovation Specialist | Applied AI/ML Engineer',
  description:
    'Technical generalist working across applied AI/ML, full-stack products, AI management, responsible adoption and practical employee training.',
  knowsAbout: [
    'AI strategy and management',
    'Enterprise AI integration',
    'AI governance and safety',
    'Employee AI training and tutoring',
    'Agentic RAG',
    'AI agents',
    'Context engineering',
    'Large language models',
    'Small language model fine-tuning',
    'Model evaluation',
    'Computer vision and OCR',
    'Audio machine learning',
    'Python',
    'Backend development',
    'Android development',
    'Kotlin',
  ],
  homeLocation: { '@type': 'Place', name: 'Zlín area, Czechia' },
  worksFor: { '@type': 'Organization', name: 'OKsystem' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Tomas Bata University in Zlín' },
  sameAs: profile.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#fafaf9" />
    <meta name="author" content="Matěj Teplý" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    {!noindex && <link rel="canonical" href={url(Astro.url.pathname)} />}
    {!noindex && (
      <>
        {languages.map((language) => (
          <link rel="alternate" hreflang={language} href={url(href(path, language))} />
        ))}
        <link rel="alternate" hreflang="x-default" href={url(href(path))} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url(Astro.url.pathname)} />
    <meta property="og:image" content={url(href('og.png'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Matěj Teplý: AI/ML engineer, backend developer, Zlín, CZ. I build software that shows its work."
    />
    <meta property="og:site_name" content="Matěj Teplý" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Both subsets: the name in the first screen needs latin-ext (ě). -->
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark')
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          if (sessionStorage.getItem('theme:matrix') === '1') theme = 'matrix';
        } catch {}
        document.documentElement.dataset.theme = theme;
        if (theme !== 'light')
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', theme === 'matrix' ? '#040a06' : '#0b0b0c');
      })();
    </script>
    {intro && <script is:inline>
      try {
        if (
          sessionStorage.getItem('intro:v3') !== '1' &&
          !location.hash &&
          !document.prerendering &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          sessionStorage.setItem('intro:v3', '1');
          document.documentElement.classList.add('intro-active');
          // Release scrolling even if the module cannot load.
          setTimeout(() => document.documentElement.classList.remove('intro-active'), 2100);
        }
      } catch {
        // Unavailable storage skips the intro, so it never repeats on every reload.
      }
    </script>}
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
  </head>
  <body data-problem-label={t.problem}>
    {intro && <Intro lang={lang} />}
    <div class="matrix-field no-print" aria-hidden="true">
      <canvas aria-hidden="true" />
    </div>
    <div class="spotlight no-print" aria-hidden="true"></div>
    <div class="matrix-transition no-print" aria-hidden="true">
      SYSTEM OVERRIDE / MATRIX
    </div>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <div class="reading-progress no-print" aria-hidden="true"></div>
    <header class="header no-print">
      <div class="header__bar frame">
        <a class="header__name" href={href('', lang)}>
          <span class="header__full">Matěj Teplý</span>
          <span class="header__short" aria-hidden="true">
            MT
          </span>
        </a>
        {chat && <Chat lang={lang} api={chat.api} siteKey={chat.siteKey} />}
        <button class="header__menu" type="button" popovertarget="site-menu" aria-label={t.menu}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 8h16M4 16h16" />
          </svg>
          {t.menu}
        </button>
        <div class="header__panel" id="site-menu" popover="auto">
          <nav class="header__main" aria-label={t.main}>
            <ul class="header__nav">
              {nav.map((n) => (
                <li>
                  <a
                    href={href(`${n.path}/`, lang)}
                    aria-current={
                      path === n.path || path.startsWith(`${n.path}/`) ? 'page' : undefined
                    }
                    data-glitch
                  >
                    <GlitchText text={n.label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav class="language-nav" aria-label={t.language}>
            {languages.map((language) => (
              <a
                href={href(path, language)}
                lang={language}
                hreflang={language}
                data-language={language}
                aria-current={language === lang ? 'page' : undefined}
              >
                {language === 'cs' ? 'CZ' : 'EN'}
              </a>
            ))}
          </nav>
          <button class="theme" type="button" aria-pressed="false">
            <span class="sr-only">{t.theme}</span>
            <svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
            </svg>
            <svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="theme__matrix" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 3v5m0 4v2m0 4v3M12 2v2m0 4v7m0 4v3M19 3v7m0 4v2m0 4v1" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer frame">
      <ul class="inline-list no-print">
        <li>
          <a class="action-link" href={href('privacy/', lang)} data-glitch>
            <GlitchText text={t.privacy} />
          </a>
        </li>
        {profile.socials.map((s) => (
          <li>
            <a class="action-link ext" href={s.href} rel="noopener me" target="_blank" data-glitch>
              <SocialIcon name={s.label} />
              <GlitchText text={s.label} />
            </a>
          </li>
        ))}
      </ul>
      <p class="meta">
        © {new Date().getFullYear()} Matěj Teplý · {t.typography} ·{' '}
        <a href="https://github.com/Majkey25/init" rel="noopener" target="_blank" data-glitch>
          <GlitchText text={t.source} />
        </a>
      </p>
    </footer>

    <script>
      import '../scripts/interactions';
      const root = document.documentElement;
      const updateLanguageLinks = () => {
        document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
          link.hash = location.hash;
        });
      };
      updateLanguageLinks();
      addEventListener('hashchange', updateLanguageLinks);

      const menuPanel = document.querySelector<HTMLElement>('#site-menu');
      const phone = matchMedia('(width < 48rem)');
      const closeMenu = () => {
        if (menuPanel?.matches(':popover-open')) menuPanel.hidePopover();
      };
      phone.addEventListener('change', closeMenu);
      menuPanel?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) closeMenu();
      });

      // Reveal the new theme as a smooth circle from the button.
      const button = document.querySelector<HTMLButtonElement>('.theme');
      const meta = document.querySelector('meta[name="theme-color"]');
      const themeLabel = button?.querySelector('.sr-only')?.textContent?.trim() ?? 'Theme';
      let clicks = 0;
      try {
        clicks = Math.min(2, Math.max(0, Number(sessionStorage.getItem('theme:clicks')) || 0));
      } catch {}
      const set = (theme: string) => {
        root.dataset.theme = theme;
        meta?.setAttribute(
          'content',
          theme === 'light' ? '#fafaf9' : theme === 'matrix' ? '#040a06' : '#0b0b0c',
        );
        button?.setAttribute('aria-pressed', String(theme !== 'light'));
        button?.setAttribute(
          'aria-label',
          `${themeLabel}: ${theme === 'matrix' ? 'Matrix' : theme}`,
        );
      };
      set(root.dataset.theme ?? 'light');
      // A page restored by Back/Forward keeps the theme it was left with; apply a newer choice.
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        try {
          clicks = Math.min(2, Math.max(0, Number(sessionStorage.getItem('theme:clicks')) || 0));
          if (sessionStorage.getItem('theme:matrix') === '1') return set('matrix');
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') set(saved);
        } catch {
          // Storage blocked: nothing newer to apply.
        }
      });
      button?.addEventListener('click', async () => {
        if (root.classList.contains('theme-switch')) return;
        const cycle = clicks >= 2 ? ['dark', 'light', 'matrix'] : ['dark', 'light'];
        const next = cycle[(cycle.indexOf(root.dataset.theme ?? 'light') + 1) % cycle.length]!;
        const apply = () => {
          set(next);
          clicks = Math.min(2, clicks + 1);
          try {
            sessionStorage.setItem('theme:clicks', String(clicks));
            if (next === 'matrix') sessionStorage.setItem('theme:matrix', '1');
            else sessionStorage.removeItem('theme:matrix');
          } catch {
            // Storage blocked: the secret mode lasts for this page only.
          }
          if (next !== 'matrix')
            try {
              localStorage.setItem('theme', next);
            } catch {}
        };
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches)
          return apply();
        const box = button.getBoundingClientRect();
        const x = box.left + box.width / 2;
        const y = box.top + box.height / 2;
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-switch');
        if (next === 'matrix') root.classList.add('theme-hack');
        const vt = document.startViewTransition(apply);
        try {
          await vt.ready;
          root.animate(
            next === 'matrix'
              ? [
                  { transform: 'translateX(-12px)', clipPath: 'inset(8% 0 60%)' },
                  { transform: 'translateX(10px)', clipPath: 'inset(48% 0 12%)' },
                  { transform: 'translateX(-6px)', clipPath: 'inset(0)' },
                  { transform: 'translateX(4px)', clipPath: 'inset(0)' },
                  { transform: 'none', clipPath: 'inset(0)' },
                ]
              : { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
            {
              duration: next === 'matrix' ? 760 : 560,
              easing: next === 'matrix' ? 'steps(1, end)' : 'cubic-bezier(0.2, 0.7, 0.2, 1)',
              pseudoElement: '::view-transition-new(root)',
            },
          );
        } catch {
          // A skipped transition still applies the selected theme.
        } finally {
          await vt.finished;
          root.classList.remove('theme-switch', 'theme-hack');
        }
      });

      // Project rows: a card with the project's problem statement trails the pointer.
      const rows = document.querySelectorAll<HTMLElement>('a.row[data-desc]');
      if (rows.length && matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const card = document.createElement('div');
        const label = document.createElement('span');
        const text = document.createElement('span');
        card.className = 'peek';
        label.className = 'peek__label';
        label.textContent = document.body.dataset.problemLabel ?? 'problem';
        card.setAttribute('aria-hidden', 'true');
        card.append(label, text);
        document.body.append(card);
        const lag = matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 0.2;
        let x = 0;
        let y = 0;
        let cx = 0;
        let cy = 0;
        let frame = 0;
        const follow = () => {
          cx += (x - cx) * lag;
          cy += (y - cy) * lag;
          card.style.translate = `${cx}px ${cy}px`;
          frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
        };
        // Right of and below the pointer, flipped when that would leave the viewport, and kept
        // inside it when neither side fits (narrow windows).
        const fit = (at: number, size: number, room: number) =>
          Math.max(
            12,
            Math.min(at + 24 + size > room - 12 ? at - 24 - size : at + 24, room - 12 - size),
          );
        const aim = (e: PointerEvent) => {
          x = fit(e.clientX, card.offsetWidth, innerWidth);
          y = fit(e.clientY, card.offsetHeight, innerHeight);
        };
        // Escape dismisses the card until the pointer enters another row.
        addEventListener('keydown', (e) => e.key === 'Escape' && card.classList.remove('is-on'));
        rows.forEach((row) => {
          row.addEventListener('pointerenter', (e) => {
            text.textContent = row.dataset.desc ?? '';
            aim(e);
            if (!card.classList.contains('is-on')) {
              cx = x;
              cy = y;
              card.style.translate = `${cx}px ${cy}px`;
            }
            card.classList.add('is-on');
          });
          row.addEventListener('pointermove', (e) => {
            aim(e);
            if (!frame) frame = requestAnimationFrame(follow);
          });
          row.addEventListener('pointerleave', () => card.classList.remove('is-on'));
        });
      }
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .header__name {
    margin-right: auto;
    white-space: nowrap;
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .header__menu {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
  }

  .header__menu svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .header__panel {
    position: static;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: visible;
  }

  .header__nav {
    display: flex;
    gap: 0.25rem;
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.7rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .header__nav a:hover {
    background: var(--surface);
    color: var(--ink);
  }

  .header__nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.5rem;
  }

  .language-nav {
    display: flex;
    flex: none;
  }

  .language-nav a {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
  }

  .language-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0.6rem 0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease);
  }

  .language-nav a:is(:hover, :focus-visible, [aria-current]) {
    color: var(--ink);
  }

  .language-nav a:is(:hover, :focus-visible, [aria-current])::after {
    transform: scaleX(1);
  }

  @media (width < 48rem) {
    .header__bar {
      gap: 0.5rem;
      padding-block: 0.4rem;
    }

    .header__menu {
      display: inline-flex;
    }

    .header__panel {
      position: fixed;
      inset: 4.5rem var(--pad) auto auto;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      width: min(24rem, calc(100% - 2 * var(--pad)));
      max-height: calc(100dvh - 5rem);
      padding: 1rem;
      overflow-y: auto;
      border: 1px solid var(--rule);
      border-radius: 1rem;
      background: var(--bg);
      color: var(--ink);
      box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.12);
      transform-origin: top right;
      transition:
        opacity 180ms var(--ease),
        transform 180ms var(--ease),
        display 180ms allow-discrete,
        overlay 180ms allow-discrete;
    }

    .header__panel:not(:popover-open) {
      display: none;
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }

    @starting-style {
      .header__panel:popover-open {
        opacity: 0;
        transform: translateY(-6px) scale(0.98);
      }
    }

    .header__main {
      grid-column: 1 / -1;
    }

    .header__nav {
      display: grid;
      gap: 0.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--rule);
    }

    .header__nav a {
      display: flex;
      font-size: 1.125rem;
      border-radius: 0.5rem;
    }

    .language-nav {
      justify-self: start;
    }
  }

  .theme {
    flex: none;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .theme::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 50%;
    background: var(--surface);
    opacity: 0;
    transform: scale(0.4);
    transition:
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .theme:focus-visible::before {
    opacity: 1;
    transform: none;
  }

  .theme svg {
    grid-area: 1 / 1;
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition:
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 160ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme:hover::before {
      opacity: 1;
      transform: none;
    }

    .theme[aria-pressed='false']:hover .theme__moon {
      transform: rotate(-24deg);
    }

    .theme[aria-pressed='true']:hover .theme__sun {
      transform: rotate(60deg);
    }
  }

  .theme .theme__sun,
  .theme .theme__matrix,
  .theme[aria-pressed='true'] .theme__moon {
    opacity: 0;
    transform: rotate(-30deg) scale(0.7);
  }

  .theme[aria-pressed='true'] .theme__sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme='matrix']) .theme .theme__sun {
    opacity: 0;
  }
  :global([data-theme='matrix']) .theme .theme__matrix {
    opacity: 1;
    transform: none;
  }

  .header__short {
    display: none;
  }

  .theme {
    flex: none;
  }

  /* Narrow phones: initials instead of the full name, which stays readable for screen readers. */
  @media (width < 30rem) {
    .header__bar {
      gap: 0.25rem;
    }

    .header__full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .header__short {
      display: inline;
    }
  }

  .footer {
    display: grid;
    gap: 0.75rem;
    margin-top: var(--section);
    padding-block: 2rem 3rem;
  }
</style>
