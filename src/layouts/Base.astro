---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import socialImage from '../assets/social.png';
import Chat from '../components/Chat.astro';
import Intro from '../components/Intro.astro';
import { chat } from '../chat';
import GlitchText from '../components/GlitchText.astro';
import SocialIcon from '../components/SocialIcon.astro';
import '../styles/global.css';
import { href, profile } from '../site';
import { languages, ui, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  intro?: boolean;
  lang?: Lang;
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'profile';
}

const {
  title,
  description,
  noindex = false,
  intro = !noindex,
  lang = 'en',
  image = socialImage,
  imageAlt = lang === 'cs'
    ? 'Matěj Teplý: Tvořím užitečný software a pomáhám týmům pracovat s AI.'
    : 'Matěj Teplý: I build useful software and help teams work with AI.',
  ogType = 'website',
} = Astro.props;
const t = ui[lang];
const path = noindex ? '' : Astro.url.pathname.slice(href().length).replace(/^cs\//, '');
const site = Astro.site ?? new URL('https://init-chat.majkeylab.workers.dev');
// shortcut: local builds share a marker; CI must build deployed revisions.
const buildRevision = process.env.GITHUB_SHA ?? 'local';
const url = (path: string) => new URL(path, site).href;
const pageTitle = title ? `${title} · Matěj Teplý` : t.title;
const pageDescription = description ?? t.description;
const nav = [
  { path: 'work', label: t.work },
  { path: 'services', label: t.services },
  { path: 'about', label: t.about },
  { path: 'contact', label: t.contact },
];
// Matrix glyph noise uses the rain vocabulary of scripts/matrix.ts, so it never spells a word.
const glyphs = '01{}[]<>/=+*;:#$_';
const noise = (length: number) =>
  Array.from({ length }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join('');
// Matrix glitch bands: top %, left %, width %, height rem.
const bands = [
  [8, 0, 62, 0.75],
  [20, 34, 66, 2.25],
  [37, 8, 44, 0.625],
  [51, 46, 54, 1.5],
  [67, 0, 76, 0.875],
  [82, 20, 58, 2.75],
] as const;
// Matrix switch terminal: inert text that CSS types (speed: ms per character, 0 = instant).
// Nothing runs. The reveal waits for the last simulated command, with a short reading pause.
const prompt = '$ ';
let typedAt = 60;
const terminal = (
  [
    ['majkey25@init:~  /dev/pts/0', 0],
    [`${prompt}pwd`, 12],
    ['/home/majkey25/init', 0],
    [`${prompt}ls src/`, 12],
    ['components  layouts  pages  styles', 0],
    [`${prompt}uname -s`, 12],
    ['Linux', 0],
    [`${prompt}node --version`, 12],
    ['v24.15.0', 0],
    [`${prompt}git status --short`, 12],
    [`${prompt}npm run check`, 12],
    ['astro check: 0 errors, 0 warnings', 0],
    [`${prompt}npm run build`, 12],
    ['> astro build', 0],
    [`building [${'#'.repeat(16)}] 100%`, 10],
    [`${prompt}test -d dist && du -sh dist`, 12],
    ['4.2M  dist', 0],
    [`${prompt}npm run preview -- --port 4321 &`, 12],
    ['[1] 4321', 0],
    ['Local: http://localhost:4321/', 0],
    [`${prompt}curl -I localhost:4321`, 12],
    ['HTTP/1.1 200 OK', 0],
    [`${prompt}lsof -i :4321 -t`, 12],
    ['4321', 0],
    [`${prompt}cd chat`, 12],
    [`${prompt}npx wrangler deploy --dry-run`, 12],
    ['[dry-run] bundle ready; upload skipped', 0],
    [`${prompt}export THEME=matrix`, 12],
    ['[ready] opening init', 0],
  ] as const
).map(([text, speed]) => {
  const command = text.startsWith(prompt);
  const steps = speed ? text.length - (command ? prompt.length : 0) : 1;
  const style = `--d:${typedAt}ms;--t:${steps * speed || 1}ms;--n:${steps}`;
  typedAt += steps * speed + (command ? 90 : 40);
  return { Line: command ? ('kbd' as const) : ('samp' as const), text, style };
});
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': url(href()) + '#person',
  name: 'Matěj Teplý',
  alternateName: ['Majkey', 'Majkey25'],
  url: url(href()),
  jobTitle: 'Technical Innovation Specialist | Applied AI/ML Engineer',
  description:
    'Technical generalist working across applied AI/ML, full-stack products, AI management, responsible adoption and practical employee training.',
  knowsAbout: [
    'AI strategy and management',
    'Enterprise AI integration',
    'AI governance and safety',
    'Employee AI training and tutoring',
    'Agentic RAG',
    'AI agents',
    'Context engineering',
    'Large language models',
    'Small language model fine-tuning',
    'Model evaluation',
    'Computer vision and OCR',
    'Audio machine learning',
    'Python',
    'Backend development',
    'Android development',
    'Kotlin',
  ],
  homeLocation: { '@type': 'Place', name: 'Zlín area, Czechia' },
  worksFor: { '@type': 'Organization', name: 'OKsystem' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Tomas Bata University in Zlín' },
  sameAs: profile.socials.map((s) => s.href),
};
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': url(href()) + '#website',
      url: url(href()),
      name: 'Matěj Teplý',
      publisher: { '@id': person['@id'] },
    },
    {
      '@type': ogType === 'profile' ? 'ProfilePage' : 'WebPage',
      '@id': url(Astro.url.pathname) + '#page',
      url: url(Astro.url.pathname),
      name: pageTitle,
      description: pageDescription,
      inLanguage: lang,
      isPartOf: { '@id': url(href()) + '#website' },
      about: { '@id': person['@id'] },
      ...(ogType === 'profile' ? { mainEntity: { '@id': person['@id'] } } : {}),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter fallback="swap" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#fafaf9" />
    <meta name="author" content="Matěj Teplý" />
    <meta name="app-revision" content={buildRevision} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    {!noindex && <link rel="canonical" href={url(Astro.url.pathname)} />}
    {!noindex && <link rel="describedby" href={href('llms.txt')} type="text/plain" />}
    {!noindex && (
      <>
        {languages.map((language) => (
          <link rel="alternate" hreflang={language} href={url(href(path, language))} />
        ))}
        <link rel="alternate" hreflang="x-default" href={url(href(path))} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url(Astro.url.pathname)} />
    <meta property="og:image" content={url(image.src)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Matěj Teplý" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={url(image.src)} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Both subsets: the name in the first screen needs latin-ext (ě). -->
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      (() => {
        // Keep the saved coordinate before Astro can clamp an unmeasured gallery on reload.
        const initialScroll = history.state?.scrollY;
        if (typeof initialScroll === 'number' && initialScroll > 0)
          document.documentElement.dataset.initialScroll = String(initialScroll);
        // Restore browser history before enabling smooth in-page anchors.
        document.documentElement.style.scrollBehavior = 'auto';
        addEventListener(
          'load',
          () => document.documentElement.style.removeProperty('scroll-behavior'),
          { once: true },
        );
        let theme;
        let surprise;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark')
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          if (sessionStorage.getItem('theme:matrix') === '1') theme = 'matrix';
          surprise = Number(sessionStorage.getItem('theme:surprise'));
        } catch {}
        document.documentElement.dataset.theme = theme;
        // The rule of set() below, before first paint, so the theme icon never cycles on load.
        document.documentElement.dataset.nextTheme =
          theme === 'matrix'
            ? 'light'
            : surprise === 1
              ? 'matrix'
              : theme === 'dark'
                ? 'light'
                : 'dark';
        if (theme !== 'light')
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', theme === 'matrix' ? '#040a06' : '#0b0b0c');
      })();
    </script>
    {intro && <script is:inline>
      try {
        if (
          document.readyState === 'loading' &&
          sessionStorage.getItem('intro:v3') !== '1' &&
          !location.hash &&
          !document.prerendering &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          sessionStorage.setItem('intro:v3', '1');
          document.documentElement.classList.add('intro-active');
          // Release scrolling even if the module cannot load.
          setTimeout(() => document.documentElement.classList.remove('intro-active'), 2100);
        }
      } catch {
        // Unavailable storage skips the intro, so it never repeats on every reload.
      }
    </script>}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  </head>
  <body data-problem-label={t.problem}>
    {intro && <Intro lang={lang} />}
    <div class="matrix-field no-print" aria-hidden="true">
      <canvas aria-hidden="true" />
    </div>
    <div class="spotlight no-print" aria-hidden="true"></div>
    <div class="matrix-transition no-print" aria-hidden="true">
      {bands.map(([y, x, w, h], i) => (
        <span style={`--y:${y}%;--x:${x}%;--w:${w}%;--h:${h}rem;--i:${i}`}>
          {noise(64).repeat(5)}
        </span>
      ))}
      <div
        class="matrix-terminal"
        data-duration={typedAt + 400}
        style={`--prompt:${prompt.length}ch`}
      >
        {terminal.map(({ Line, text, style }) => (
          <Line style={style}>{text}</Line>
        ))}
      </div>
    </div>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <div class="reading-progress no-print" aria-hidden="true"></div>
    <header class="header no-print">
      <div class="header__bar frame">
        <a class="header__name" href={href('', lang)}>
          Majkey25
        </a>
        {chat && <Chat lang={lang} api={chat.api} siteKey={chat.siteKey} />}
        <button class="header__menu" type="button" popovertarget="site-menu" aria-label={t.menu}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 8h16M4 16h16" />
          </svg>
          {t.menu}
        </button>
        <div class="header__panel" id="site-menu" popover="auto">
          <nav class="header__main" aria-label={t.main}>
            <ul class="header__nav">
              {nav.map((n) => (
                <li>
                  <a
                    href={href(`${n.path}/`, lang)}
                    aria-current={
                      path === n.path || path.startsWith(`${n.path}/`) ? 'page' : undefined
                    }
                    data-glitch
                  >
                    <GlitchText text={n.label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav class="language-nav" aria-label={t.language}>
            {languages.map((language) => (
              <a
                href={href(path, language)}
                lang={language}
                hreflang={language}
                data-language={language}
                aria-current={language === lang ? 'page' : undefined}
              >
                {language === 'cs' ? 'CZ' : 'EN'}
              </a>
            ))}
          </nav>
          <div class="theme-controls">
            <button class="theme" type="button">
              <span class="sr-only">{t.theme}</span>
              <svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z" />
              </svg>
              <svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <span class="theme__matrix" aria-hidden="true">
                {Array.from({ length: 8 }, (_, i) => (
                  <span style={`--i:${i}`}>{noise(8).repeat(2)}</span>
                ))}
              </span>
            </button>
            <button
              class="theme-hint"
              type="button"
              aria-label={t.themeHint}
              aria-describedby="theme-hint-text"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v6M12 7v1" />
              </svg>
              <span class="theme-hint__tip" id="theme-hint-text" role="tooltip">
                <span>{t.themeSurprise}</span>
              </span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer frame">
      <ul class="inline-list no-print">
        <li>
          <a class="action-link" href={href('privacy/', lang)} data-glitch>
            <GlitchText text={t.privacy} />
          </a>
        </li>
        {profile.socials.map((s) => (
          <li>
            <a class="action-link ext" href={s.href} rel="noopener me" target="_blank" data-glitch>
              <SocialIcon name={s.label} />
              <GlitchText text={s.label} />
            </a>
          </li>
        ))}
      </ul>
      <p class="meta">
        © {new Date().getFullYear()} Matěj Teplý · {t.typography}{' '}
        <a href="https://github.com/github/mona-sans" rel="noopener" target="_blank">
          Mona Sans
        </a>
        {' · '}
        {t.builtWith}{' '}
        <a href="https://astro.build/" rel="noopener" target="_blank">
          Astro
        </a>{' '}
        ·{' '}
        <a href="https://github.com/Majkey25/init" rel="noopener" target="_blank" data-glitch>
          <GlitchText text={t.source} />
        </a>
      </p>
    </footer>

    <script>
      import '../scripts/interactions';
      import { onPage } from '../scripts/page';
      onPage((signal) => {
        const root = document.documentElement;
        const updateLanguageLinks = () => {
          document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
            link.hash = location.hash;
          });
        };
        updateLanguageLinks();
        addEventListener('hashchange', updateLanguageLinks, { signal });

        const menuPanel = document.querySelector<HTMLElement>('#site-menu');
        const phone = matchMedia('(width < 48rem)');
        const closeMenu = () => {
          if (menuPanel?.matches(':popover-open')) menuPanel.hidePopover();
        };
        phone.addEventListener('change', closeMenu, { signal });
        menuPanel?.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a')) closeMenu();
        });

        // Classic themes reveal from the button; Matrix opens an inert terminal immediately.
        const button = document.querySelector<HTMLButtonElement>('.theme');
        const meta = document.querySelector('meta[name="theme-color"]');
        const themeLabel = button?.querySelector('.sr-only')?.textContent?.trim() ?? 'Theme';
        const systemTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const rollSurprise = () => 3 + Math.floor(Math.random() * 6);
        const loadSurprise = () => {
          try {
            const saved = Number(sessionStorage.getItem('theme:surprise'));
            if (Number.isInteger(saved) && saved >= 1 && saved <= 8) return saved;
          } catch {}
          const count = rollSurprise();
          try {
            sessionStorage.setItem('theme:surprise', String(count));
          } catch {}
          return count;
        };
        let remaining = loadSurprise();
        let finishTheme = () => {};
        const set = (theme: string) => {
          root.dataset.theme = theme;
          // Matrix always exits to light. Keep in sync with the inline script in <head>.
          const next =
            theme === 'matrix'
              ? 'light'
              : remaining === 1
                ? 'matrix'
                : theme === 'dark'
                  ? 'light'
                  : 'dark';
          root.dataset.nextTheme = next;
          meta?.setAttribute(
            'content',
            theme === 'light' ? '#fafaf9' : theme === 'matrix' ? '#040a06' : '#0b0b0c',
          );
          button?.setAttribute(
            'aria-label',
            `${themeLabel}: ${next === 'matrix' ? 'Matrix' : root.lang === 'cs' ? (next === 'dark' ? 'tmavý' : 'světlý') : next}`,
          );
        };
        set(root.dataset.theme ?? 'light');
        // A page restored by Back/Forward keeps the theme it was left with; apply a newer choice.
        const refreshTheme = () => {
          remaining = loadSurprise();
          let theme = root.dataset.theme ?? systemTheme;
          try {
            if (sessionStorage.getItem('theme:matrix') === '1') theme = 'matrix';
            else {
              const saved = localStorage.getItem('theme');
              if (saved === 'light' || saved === 'dark') theme = saved;
            }
          } catch {
            // Keep the cached theme if its stored choice is unavailable.
          }
          set(theme);
        };
        addEventListener(
          'pageshow',
          (e) => {
            if (e.persisted) refreshTheme();
          },
          { signal },
        );
        button?.addEventListener('click', async () => {
          if (root.classList.contains('theme-switch')) return;
          const next = root.dataset.nextTheme!;
          const remainingAfter =
            next === 'matrix'
              ? rollSurprise()
              : root.dataset.theme === 'matrix'
                ? remaining
                : remaining - 1;
          const apply = () => {
            remaining = remainingAfter;
            try {
              sessionStorage.setItem('theme:surprise', String(remaining));
            } catch {}
            set(next);
            try {
              if (next === 'matrix') sessionStorage.setItem('theme:matrix', '1');
              else sessionStorage.removeItem('theme:matrix');
            } catch {
              // Storage blocked: Matrix lasts for this page only.
            }
            if (next !== 'matrix')
              try {
                localStorage.setItem('theme', next);
              } catch {}
          };
          const motion = matchMedia('(prefers-reduced-motion: reduce)');
          if (motion.matches) return apply();
          if (next === 'matrix') {
            // Swap under the opaque terminal after its last line (global.css), then reveal. Escape,
            // a hidden tab or leaving the page finishes at once, so a cached page never freezes.
            closeMenu();
            root.classList.add('theme-switch', 'theme-hack');
            let timer = setTimeout(
              () => {
                apply();
                root.classList.add('theme-reveal');
                timer = setTimeout(finish, 700);
              },
              Number(document.querySelector<HTMLElement>('.matrix-terminal')!.dataset.duration),
            );
            const stop = new AbortController();
            const finish = () => {
              clearTimeout(timer);
              stop.abort();
              if (root.dataset.theme !== next) apply();
              root.classList.remove('theme-switch', 'theme-hack', 'theme-reveal');
              finishTheme = () => {};
            };
            finishTheme = finish;
            const { signal } = stop;
            addEventListener('pagehide', finish, { signal });
            addEventListener('keydown', (e) => e.key === 'Escape' && finish(), { signal });
            document.addEventListener('visibilitychange', () => document.hidden && finish(), {
              signal,
            });
            motion.addEventListener('change', () => motion.matches && finish(), { signal });
            return;
          }
          if (!document.startViewTransition) return apply();
          const box = button.getBoundingClientRect();
          const x = box.left + box.width / 2;
          const y = box.top + box.height / 2;
          const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.classList.add('theme-switch');
          const vt = document.startViewTransition(() => {
            if (!signal.aborted) apply();
          });
          let reveal: Animation | undefined;
          finishTheme = () => {
            if (root.dataset.theme !== next) apply();
            vt.skipTransition();
            reveal?.cancel();
            root.classList.remove('theme-switch');
          };
          try {
            await vt.ready;
            if (signal.aborted) return;
            reveal = root.animate(
              { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
              {
                duration: 560,
                easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
                pseudoElement: '::view-transition-new(root)',
              },
            );
          } catch {
            // A skipped transition still applies the selected theme.
          } finally {
            await vt.finished;
            if (!signal.aborted) {
              root.classList.remove('theme-switch');
              finishTheme = () => {};
            }
          }
        });

        const hint = document.querySelector<HTMLButtonElement>('.theme-hint');
        const showHint = () => {
          if (hint) delete hint.dataset.dismissed;
        };
        for (const event of ['pointerenter', 'focus']) hint?.addEventListener(event, showHint);
        hint?.addEventListener('click', () => {
          showHint();
          hint.focus();
        });
        addEventListener(
          'keydown',
          (event) => {
            if (
              event.key !== 'Escape' ||
              !hint ||
              getComputedStyle(hint.querySelector('.theme-hint__tip')!).visibility !== 'visible'
            )
              return;
            event.preventDefault();
            event.stopPropagation();
            hint.dataset.dismissed = '';
          },
          { signal },
        );

        // Project rows: a card with the project's problem statement trails the pointer.
        const rows = document.querySelectorAll<HTMLElement>('a.row[data-desc]');
        if (rows.length && matchMedia('(hover: hover) and (pointer: fine)').matches) {
          const card = document.createElement('div');
          const label = document.createElement('span');
          const text = document.createElement('span');
          card.className = 'peek';
          label.className = 'peek__label';
          label.textContent = document.body.dataset.problemLabel ?? 'problem';
          card.setAttribute('aria-hidden', 'true');
          card.append(label, text);
          document.body.append(card);
          const lag = matchMedia('(prefers-reduced-motion: reduce)').matches ? 1 : 0.2;
          let x = 0;
          let y = 0;
          let cx = 0;
          let cy = 0;
          let frame = 0;
          const follow = () => {
            cx += (x - cx) * lag;
            cy += (y - cy) * lag;
            card.style.translate = `${cx}px ${cy}px`;
            frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
          };
          // Right of and below the pointer, flipped when that would leave the viewport, and kept
          // inside it when neither side fits (narrow windows).
          const fit = (at: number, size: number, room: number) =>
            Math.max(
              12,
              Math.min(at + 24 + size > room - 12 ? at - 24 - size : at + 24, room - 12 - size),
            );
          const aim = (e: PointerEvent) => {
            x = fit(e.clientX, card.offsetWidth, innerWidth);
            y = fit(e.clientY, card.offsetHeight, innerHeight);
          };
          // Escape dismisses the card until the pointer enters another row.
          addEventListener('keydown', (e) => e.key === 'Escape' && card.classList.remove('is-on'), {
            signal,
          });
          rows.forEach((row) => {
            row.addEventListener('pointerenter', (e) => {
              text.textContent = row.dataset.desc ?? '';
              aim(e);
              if (!card.classList.contains('is-on')) {
                cx = x;
                cy = y;
                card.style.translate = `${cx}px ${cy}px`;
              }
              card.classList.add('is-on');
            });
            row.addEventListener('pointermove', (e) => {
              aim(e);
              if (!frame) frame = requestAnimationFrame(follow);
            });
            row.addEventListener('pointerleave', () => card.classList.remove('is-on'));
          });
          signal.addEventListener('abort', () => cancelAnimationFrame(frame), { once: true });
        }
        return () => {
          finishTheme();
          closeMenu();
        };
      });
      document.addEventListener('astro:before-preparation', (event) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          // A deployed revision needs a fresh script realm, including its custom elements.
          const revision = (doc: Document) =>
            doc.querySelector<HTMLMetaElement>('meta[name="app-revision"]')?.content;
          if (revision(document) === revision(event.newDocument)) return;
          event.preventDefault();
          // Traversal already changed the URL, so its fragment fallback needs an explicit reload.
          if (event.navigationType === 'traverse' && event.to.hash && !event.signal.aborted)
            location.reload();
        };
      });
      document.addEventListener('astro:before-swap', (event) => {
        // Transfer only the selected theme; route labels and temporary classes belong to the new page.
        const root = document.documentElement;
        const next = event.newDocument;
        for (const key of ['theme', 'nextTheme'])
          next.documentElement.dataset[key] = root.dataset[key];
        next
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            'content',
            document.querySelector('meta[name="theme-color"]')?.getAttribute('content') ??
              '#fafaf9',
          );
        // Skipping the route snapshot rejects ready; the page and its own entrances still load.
        void event.viewTransition.ready.catch(() => undefined);
        event.viewTransition.skipTransition();
      });
    </script>
  </body>
</html>

